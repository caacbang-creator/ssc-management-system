# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000

# MySQL / MariaDB (XAMPP default: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ssc_db

# Demo password given to every seeded account (choose your own)
SEED_PASSWORD=

# Long random string that signs the login cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
