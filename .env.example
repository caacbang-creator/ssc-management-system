# Copy this file to .env and fill in your own values. Never commit .env.
# On the hosting service, enter these in its dashboard (Environment) instead.
PORT=3000

# 'production' on the live site: turns on the HTTPS-only session cookie
NODE_ENV=development

# MySQL / MariaDB (XAMPP default: user root, empty password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ssc_db

# Hosted database only: DB_SSL=true turns on TLS. Paste the provider's CA certificate
# (the whole ca.pem text, including BEGIN/END lines) into DB_CA_CERT.
DB_SSL=false
DB_CA_CERT=

# Demo password given to every seeded account (choose your own)
SEED_PASSWORD=

# Long random string that signs the login cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
