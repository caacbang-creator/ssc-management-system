<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
  const r = report;
  const spent = Number(r.total_expenses);
  const sold = Number(r.total_sales);
  const net = sold - spent;
%>

<main id="main" class="container">
  <a class="back-link" href="/documents"><span aria-hidden="true">&larr;</span> Reports and documents</a>

  <div class="page-heading">
    <div>
      <p class="eyebrow">Liquidation report &middot; School year <%= r.school_year.replace('-', '–') %></p>
      <h1><%= r.title %></h1>
      <p class="page-lead"><%= formatDate(r.period_start) %><% if (r.period_end !== r.period_start) { %> &ndash; <%= formatDate(r.period_end) %><% } %></p>
    </div>
  </div>

  <%# The numbers people want first, big and side by side %>
  <div class="<%= sold > 0 ? 'card-grid-3' : 'card-grid-2' %>">
    <div class="card stat-card dash-stat">
      <span class="icon-tile"><%- include('../partials/icon', { name: 'clipboard' }) %></span>
      <span><span class="stat-number"><%= formatMoney(spent) %></span> <span class="stat-label">Total expenses (<%= expenses.length %> receipts)</span></span>
    </div>
    <% if (sold > 0) { %>
      <div class="card stat-card dash-stat">
        <span class="icon-tile"><%- include('../partials/icon', { name: 'money' }) %></span>
        <span><span class="stat-number"><%= formatMoney(sold) %></span> <span class="stat-label">Total sales</span></span>
      </div>
      <div class="card stat-card dash-stat stat-card-active">
        <span class="icon-tile"><%- include('../partials/icon', { name: 'check' }) %></span>
        <span><span class="stat-number"><%= formatMoney(net) %></span> <span class="stat-label"><%= net >= 0 ? 'Net income' : 'Net loss' %></span></span>
      </div>
    <% } else { %>
      <div class="card stat-card dash-stat">
        <span class="icon-tile"><%- include('../partials/icon', { name: 'calendar' }) %></span>
        <span><span class="stat-number"><%= formatDate(r.published_at) %></span> <span class="stat-label">Published</span></span>
      </div>
    <% } %>
  </div>

  <section class="card section-gap" aria-labelledby="receipts-title">
    <h2 id="receipts-title">Expenses</h2>
    <% if (expenses.length === 0) { %>
      <p class="muted">No receipts listed.</p>
    <% } else { %>
      <%- include('../partials/expense-table', { expenses, editBase: '' }) %>
    <% } %>
  </section>

  <% if (sales.length > 0) { %>
    <div class="report-split section-gap">
      <section class="card" aria-labelledby="sales-title">
        <h2 id="sales-title">Sales summary</h2>
        <%- include('../partials/sales-table', { sales, editBase: '' }) %>
      </section>

      <section class="card income-card" aria-labelledby="income-title">
        <h2 id="income-title">Income and expense summary</h2>
        <dl class="income-list">
          <div><dt>Gross sales</dt><dd><%= formatMoney(sold) %></dd></div>
          <div><dt>Less: expenses</dt><dd>(<%= formatMoney(spent) %>)</dd></div>
          <div class="income-total"><dt><%= net >= 0 ? 'Net income' : 'Net loss' %></dt><dd><%= formatMoney(net) %></dd></div>
        </dl>
      </section>
    </div>
  <% } %>

  <% if (r.notes) { %>
    <section class="card section-gap">
      <h2>Notes</h2>
      <p class="keep-lines prose"><%= r.notes %></p>
    </section>
  <% } %>

  <p class="meta section-gap">Published <%= formatDate(r.published_at) %>. Totals are added up from the receipts and sales listed above.</p>
</main>

<%- include('../partials/foot') %>
