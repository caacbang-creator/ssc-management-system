<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Services</p>
      <h1>My requests</h1>
      <p class="page-lead">Book a clearance or SSC appointment, or borrow an item.</p>
    </div>
    <a class="btn btn-primary" href="/transactions/new">Make a request <span class="arrow" aria-hidden="true">&rarr;</span></a>
  </div>

  <% if (transactions.length === 0) { %>
    <div class="card empty-state">
      <p>You haven't made any requests yet.</p>
      <a class="btn btn-secondary" href="/items">See what you can borrow</a>
    </div>
  <% } else { %>
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Request</th>
            <th scope="col">Date</th>
            <th scope="col">Status</th>
            <th scope="col">Code</th>
          </tr>
        </thead>
        <tbody>
          <% transactions.forEach((t) => { %>
            <tr>
              <td><a href="/transactions/<%= t.id %>"><%= transactionTypes[t.type] %><% if (t.item_name) { %>: <%= t.item_name %><% } %></a></td>
              <td><%= formatDate(t.preferred_date) %></td>
              <td><%- include('../partials/status-pill', { status: t.status }) %></td>
              <td class="muted"><%= t.reference_no %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <div class="page-end">
    <p>Need to borrow something? See what's available.</p>
    <div class="action-row">
      <% if (['pro', 'vp_internal', 'president'].includes(currentUser.role)) { %>
        <a class="btn btn-secondary" href="/manage/transactions">Manage requests</a>
      <% } %>
      <a class="btn btn-secondary" href="/items">Items you can borrow <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</main>

<%- include('../partials/foot') %>
