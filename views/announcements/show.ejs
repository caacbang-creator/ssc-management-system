<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main id="main" class="container">
  <a class="back-link" href="/announcements"><span aria-hidden="true">&larr;</span> All news</a>

  <article class="card">
    <p class="meta"><span class="tag"><%= announcement.category.charAt(0).toUpperCase() + announcement.category.slice(1) %></span> Posted <%= formatDate(announcement.published_at) %></p>
    <h1><%= announcement.title %></h1>
    <p class="keep-lines prose"><%= announcement.body %></p>
  </article>

  <div class="page-end">
    <p>Have a question about this?</p>
    <a class="btn btn-primary" href="/concerns/new">Ask the SSC <span class="arrow" aria-hidden="true">&rarr;</span></a>
  </div>
</main>

<%- include('../partials/foot') %>
