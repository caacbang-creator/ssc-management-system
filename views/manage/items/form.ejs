<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container form-page">
  <a class="back-link" href="/manage/items"><span aria-hidden="true">&larr;</span> Items</a>

  <section class="card">
    <h1><%= title %></h1>
    <%- include('../../partials/form-errors') %>

    <form method="post" action="<%= action %>" novalidate>
      <div class="form-field">
        <label for="name">Item name</label>
        <input type="text" id="name" name="name" value="<%= old.name || '' %>" maxlength="100" required>
      </div>
      <div class="form-field">
        <label for="description">Description <span class="optional">(optional)</span></label>
        <input type="text" id="description" name="description" value="<%= old.description || '' %>" maxlength="255">
      </div>
      <div class="form-field">
        <label for="quantity">Quantity</label>
        <input type="text" id="quantity" name="quantity" value="<%= old.quantity || '' %>" inputmode="numeric"
          maxlength="4" aria-describedby="quantity-hint" required>
        <p class="hint" id="quantity-hint">How many the SSC owns (1 to 9999)</p>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save item</button>
        <a class="btn btn-secondary" href="/manage/items">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include('../../partials/foot') %>
