<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container form-page">
  <a class="back-link" href="/manage/financial-reports/<%= report.id %>#sales"><span aria-hidden="true">&larr;</span> <%= report.title %></a>

  <section class="card">
    <h1>Edit sales line</h1>
    <p class="muted">Total sales = quantity sold &times; unit price. It is worked out for you.</p>
    <%- include('../../partials/form-errors') %>

    <form method="post" action="/manage/financial-reports/<%= report.id %>/sales/<%= lineId %>" novalidate>
      <div class="form-field">
        <label for="product">Product</label>
        <input type="text" id="product" name="product" value="<%= old.product || '' %>" maxlength="100" required>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="quantity">Quantity sold</label>
          <input type="text" id="quantity" name="quantity" value="<%= old.quantity || '' %>" inputmode="numeric" maxlength="5" required>
        </div>
        <div class="form-field">
          <label for="unit_price">Unit price (₱)</label>
          <input type="text" id="unit_price" name="unit_price" value="<%= old.unit_price || '' %>" inputmode="decimal" maxlength="16" required>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" href="/manage/financial-reports/<%= report.id %>#sales">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include('../../partials/foot') %>
