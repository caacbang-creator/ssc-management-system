<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container form-page">
  <a class="back-link" href="/manage/financial-reports"><span aria-hidden="true">&larr;</span> Financial reports</a>

  <section class="card">
    <h1><%= title %></h1>
    <p class="muted">Saved as a draft. The remaining balance is worked out for you.</p>

    <% if (remarks) { %>
      <div class="alert alert-info">
        <p><strong>Notes from the President:</strong></p>
        <p class="keep-lines"><%= remarks %></p>
      </div>
    <% } %>

    <%- include('../../partials/form-errors') %>

    <form method="post" action="<%= action %>" novalidate>
      <div class="form-field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= old.title || '' %>" maxlength="150" required>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="period_start">Period start</label>
          <input type="date" id="period_start" name="period_start" value="<%= old.period_start || '' %>" required>
        </div>
        <div class="form-field">
          <label for="period_end">Period end</label>
          <input type="date" id="period_end" name="period_end" value="<%= old.period_end || '' %>" required>
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="budget">Budget (₱)</label>
          <input type="text" id="budget" name="budget" value="<%= old.budget || '' %>" inputmode="decimal"
            maxlength="16" aria-describedby="money-hint" placeholder="15000" required>
        </div>
        <div class="form-field">
          <label for="expenses">Expenses (₱)</label>
          <input type="text" id="expenses" name="expenses" value="<%= old.expenses || '' %>" inputmode="decimal"
            maxlength="16" aria-describedby="money-hint" placeholder="12350.50" required>
        </div>
      </div>
      <p class="hint" id="money-hint">Numbers only, like 15000 or 12350.50</p>
      <div class="form-field section-gap">
        <label for="notes">Notes <span class="optional">(optional)</span></label>
        <textarea id="notes" name="notes" rows="5" maxlength="5000"><%= old.notes || '' %></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save draft</button>
        <a class="btn btn-secondary" href="/manage/financial-reports">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include('../../partials/foot') %>
