<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<%
  const canWrite = ['treasurer', 'president'].includes(currentUser.role);
  const amount = budget ? Number(budget.amount) : 0;
  const spent = Number(totals.spent);
  const used = amount > 0 ? Math.min(100, Math.round(spent / amount * 100)) : 0;
%>

<main id="main" class="container">
  <a class="back-link" href="/manage/financial-reports"><span aria-hidden="true">&larr;</span> Financial reports</a>

  <div class="page-heading">
    <div>
      <p class="eyebrow">School year <%= schoolYear.replace('-', '–') %></p>
      <h1>Annual budget</h1>
      <p class="page-lead">One budget for the whole year. Spending is added up from the published reports.</p>
    </div>
  </div>

  <div class="wide-split">
    <section class="card" aria-labelledby="year-title">
      <h2 id="year-title" class="aside-title">This year so far</h2>
      <% if (!budget) { %>
        <p class="muted">No budget set for <%= schoolYear.replace('-', '–') %> yet.</p>
      <% } else { %>
        <div class="budget-figures">
          <div><span class="stat-number"><%= formatMoney(amount) %></span><span class="stat-label">Budget</span></div>
          <div><span class="stat-number"><%= formatMoney(spent) %></span><span class="stat-label">Spent (published reports)</span></div>
          <div><span class="stat-number"><%= formatMoney(amount - spent) %></span><span class="stat-label"><%= amount - spent < 0 ? 'Over budget' : 'Left' %></span></div>
        </div>
        <progress class="money-bar" max="100" value="<%= used %>" aria-label="Budget used"><%= used %>%</progress>
        <p class="hint"><%= used %>% of the budget used. Income from sales: <%= formatMoney(totals.sales) %>.</p>
      <% } %>
    </section>

    <aside class="wide-aside" aria-labelledby="set-title">
      <div class="card">
        <h2 id="set-title" class="aside-title"><%= budget ? 'Change the budget' : 'Set the budget' %></h2>
        <% if (canWrite) { %>
          <%- include('../../partials/form-errors') %>
          <form method="post" action="/manage/financial-reports/budget" novalidate>
            <div class="form-field">
              <label for="amount">Budget for <%= schoolYear.replace('-', '–') %> (₱)</label>
              <input type="text" id="amount" name="amount" value="<%= old.amount || '' %>" inputmode="decimal"
                maxlength="16" aria-describedby="amount-hint" required>
              <p class="hint" id="amount-hint">Numbers only, like 1000000</p>
            </div>
            <button type="submit" class="btn btn-primary">Save budget</button>
          </form>
        <% } else { %>
          <p class="muted">Only the Treasurer and the President can change it.</p>
        <% } %>
      </div>
    </aside>
  </div>
</main>

<%- include('../../partials/foot') %>
