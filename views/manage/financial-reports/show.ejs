<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<% const r = report; %>

<main id="main" class="container">
  <a class="back-link" href="/manage/financial-reports"><span aria-hidden="true">&larr;</span> Financial reports</a>

  <div class="page-heading">
    <div>
      <h1><%= r.title %></h1>
      <p class="page-lead"><%= formatDate(r.period_start) %> &ndash; <%= formatDate(r.period_end) %></p>
    </div>
    <%- include('../../partials/status-pill', { status: r.status }) %>
  </div>

  <div class="split">
    <div>
      <% if (r.review_remarks) { %>
        <div class="alert alert-info">
          <p><strong>Notes from the President:</strong></p>
          <p class="keep-lines"><%= r.review_remarks %></p>
        </div>
      <% } %>

      <div class="card-grid-3">
        <div class="card stat-card">
          <span class="stat-number"><%= formatMoney(r.budget) %></span>
          <span class="stat-label">Budget</span>
        </div>
        <div class="card stat-card">
          <span class="stat-number"><%= formatMoney(r.expenses) %></span>
          <span class="stat-label">Spent</span>
        </div>
        <div class="card stat-card stat-card-active">
          <span class="stat-number"><%= formatMoney(r.remaining_balance) %></span>
          <span class="stat-label"><%= Number(r.remaining_balance) < 0 ? 'Over budget' : 'Left' %></span>
        </div>
      </div>

      <% if (r.notes) { %>
        <section class="card section-gap">
          <h2>Notes</h2>
          <p class="keep-lines prose"><%= r.notes %></p>
        </section>
      <% } %>

      <p class="meta section-gap">
        By <%= r.author_name %> &middot; updated <%= formatDate(r.updated_at) %>
        <% if (r.reviewer_name) { %> &middot; reviewed by <%= r.reviewer_name %><% } %>
      </p>
    </div>

    <aside class="split-aside" aria-label="Next step">
      <%- include('../../partials/review-actions', {
        base: '/manage/financial-reports', id: r.id, status: r.status, label: 'report',
        canWrite: ['treasurer', 'president'].includes(currentUser.role),
        canPublish: currentUser.role === 'president',
        publicUrl: '/documents/financial-reports/' + r.id
      }) %>
    </aside>
  </div>
</main>

<%- include('../../partials/foot') %>
