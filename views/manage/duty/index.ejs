<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow">President</p>
      <h1>Officer of the Day</h1>
      <p class="page-lead">Who is on duty in the SSC office each weekday, and the code officers type to check in.</p>
    </div>
    <div class="action-row">
      <a class="btn btn-secondary" href="/manage/duty/now">Office now</a>
      <a class="btn btn-secondary" href="/manage/duty/performance">Performance</a>
    </div>
  </div>

  <div class="wide-split">
    <%# ---------- Weekly schedule ---------- %>
    <section class="card" aria-labelledby="schedule-title">
      <h2 id="schedule-title">Weekly duty schedule</h2>
      <% if (week.length === 0) { %>
        <p class="muted">No one is scheduled yet. Add the first officer below.</p>
      <% } else { %>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th scope="col">Day</th>
                <th scope="col">Officer</th>
                <th scope="col">Starts</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
              </tr>
            </thead>
            <tbody>
              <% week.forEach((d) => { %>
                <tr>
                  <th scope="row"><%= dayNames[d.day_of_week] %></th>
                  <td><%= d.first_name %> <%= d.last_name %> <span class="meta">&middot; <%= roleLabels[d.role] || d.role %></span></td>
                  <td class="nowrap"><%= formatTime(d.start_time) %></td>
                  <td class="actions">
                    <form method="post" action="/manage/duty/schedule/<%= d.id %>/delete" class="inline-form">
                      <button type="submit" class="btn btn-danger btn-sm">Remove <span class="visually-hidden"><%= d.first_name %> on <%= dayNames[d.day_of_week] %></span></button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>

      <h3 class="section-gap-sm">Add an officer to the schedule</h3>
      <%- include('../../partials/form-errors') %>
      <form method="post" action="/manage/duty/schedule" class="line-form" novalidate>
        <div class="form-field">
          <label for="user_id">Officer</label>
          <select id="user_id" name="user_id">
            <option value="">Choose an officer</option>
            <% officers.forEach((o) => { %>
              <option value="<%= o.id %>"<% if (String(o.id) === old.user_id) { %> selected<% } %>><%= o.first_name %> <%= o.last_name %> (<%= o.position || roleLabels[o.role] %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="form-field">
          <label for="day_of_week">Day</label>
          <select id="day_of_week" name="day_of_week">
            <option value="">Choose a day</option>
            <% weekOrder.forEach((d) => { %>
              <option value="<%= d %>"<% if (String(d) === old.day_of_week) { %> selected<% } %>><%= dayNames[d] %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-field">
          <label for="start_time">Start time</label>
          <input type="time" id="start_time" name="start_time" value="<%= old.start_time %>" aria-describedby="start-hint" required>
          <p class="hint" id="start-hint">Time In more than 15 minutes later counts as late.</p>
        </div>
        <div class="line-form-button">
          <button type="submit" class="btn btn-primary">Add to schedule</button>
        </div>
      </form>
    </section>

    <%# ---------- Office code ---------- %>
    <aside class="wide-aside" aria-labelledby="code-title">
      <div class="card office-code-card">
        <h2 id="code-title" class="aside-title">Office code</h2>
        <% if (office) { %>
          <p class="office-code" aria-label="Office code: <%= office.code.split('').join(' ') %>"><%= office.code %></p>
          <p class="meta">Changed <%= formatDate(office.updated_at) %></p>
          <p class="hint">Officers need this code to Time In and Time Out. Keep it at the SSC office only.</p>
          <label for="check-in-link" class="file-label section-gap-sm">Check-in link</label>
          <input type="text" id="check-in-link" value="<%= checkInLink %>" readonly>
          <p class="hint">Paste this link into any QR code generator and print it for the office desk.
            Officers scan it with their phone's normal camera; this site has no camera or QR code of its own.</p>
        <% } else { %>
          <p class="muted">No code yet. Create one below.</p>
        <% } %>
        <form method="post" action="/manage/duty/code" class="section-gap-sm">
          <button type="submit" class="btn btn-danger"><%= office ? 'Regenerate code' : 'Create a code' %></button>
        </form>
        <p class="hint">A new code stops the old code and old QR links at once. Do it weekly, or right away if it leaks.</p>
      </div>
    </aside>
  </div>
</main>

<%- include('../../partials/foot') %>
