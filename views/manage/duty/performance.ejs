<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container">
  <a class="back-link" href="/manage/duty"><span aria-hidden="true">&larr;</span> Officer of the Day</a>

  <div class="page-heading">
    <div>
      <p class="eyebrow">President</p>
      <h1>Officer performance</h1>
      <p class="page-lead">Duty record from the office check-in log. All times are from the server clock.</p>
    </div>
    <a class="btn btn-secondary" href="/manage/duty/now">Office now</a>
  </div>

  <%# ---------- Filter (a GET form: it only reads, so the URL can be bookmarked) ---------- %>
  <section class="card" aria-labelledby="filter-title">
    <h2 id="filter-title" class="visually-hidden">Choose an officer and a period</h2>
    <%- include('../../partials/form-errors') %>
    <form method="get" action="/manage/duty/performance" class="performance-filter" novalidate>
      <div class="form-field">
        <label for="user">Officer</label>
        <select id="user" name="user">
          <% officers.forEach((o) => { %>
            <option value="<%= o.id %>"<% if (o.id === filter.user) { %> selected<% } %>><%= o.first_name %> <%= o.last_name %> (<%= o.position || roleLabels[o.role] %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="form-field">
        <label for="from">From</label>
        <input type="date" id="from" name="from" value="<%= filter.from %>">
      </div>
      <div class="form-field">
        <label for="to">To</label>
        <input type="date" id="to" name="to" value="<%= filter.to %>">
      </div>
      <button type="submit" class="btn btn-primary">Show</button>
    </form>
  </section>

  <% if (noOfficers) { %>
    <div class="card empty-state section-gap"><p>There are no officers yet.</p></div>
  <% } else { %>

    <%# ---------- Who ---------- %>
    <section class="card section-gap" aria-labelledby="officer-title">
      <div class="officer-head">
        <%- include('../../partials/avatar', { person: officer, size: 'lg', duty: scheduleText.length > 0 }) %>
        <div>
          <h2 id="officer-title"><%= officer.first_name %> <%= officer.last_name %></h2>
          <p class="meta"><%= officer.position || roleLabels[officer.role] %></p>
          <% if (scheduleText.length > 0) { %>
            <p><span class="tag tag-duty">OOTD</span> <%= scheduleText.join(' · ') %></p>
          <% } else { %>
            <p class="muted">Not on the duty schedule.</p>
          <% } %>
          <p class="hint"><%= formatDate(filter.from) %> to <%= formatDate(filter.to) %><% if (countedUntil && countedUntil !== filter.to) { %>, counted up to <%= formatDate(countedUntil) %> (later days have not happened yet)<% } %>.</p>
        </div>
      </div>
    </section>

    <%# ---------- The numbers ---------- %>
    <h2 class="visually-hidden">Duty record</h2>
    <div class="card-grid section-gap">
      <div class="card stat-card"><span class="stat-number"><%= stats.scheduled %></span><span class="stat-label">Duties scheduled</span></div>
      <div class="card stat-card"><span class="stat-number"><%= stats.done %></span><span class="stat-label">Duties completed</span></div>
      <div class="card stat-card stat-card-active"><span class="stat-number"><%= stats.rate %></span><span class="stat-label">Attendance rate</span></div>
      <div class="card stat-card<%= stats.missed > 0 ? ' stat-card-active' : '' %>"><span class="stat-number"><%= stats.missed %></span><span class="stat-label">Missed duties</span></div>
      <div class="card stat-card"><span class="stat-number"><%= stats.late %></span><span class="stat-label">Late arrivals (15+ min)</span></div>
      <div class="card stat-card"><span class="stat-number"><%= stats.missingTimeouts %></span><span class="stat-label">Missing time-outs</span></div>
      <div class="card stat-card"><span class="stat-number"><%= stats.dutyHours %> h</span><span class="stat-label">Hours on duty</span></div>
      <div class="card stat-card"><span class="stat-number"><%= stats.visitHours %> h</span><span class="stat-label">Hours visiting (<%= stats.visits %> visits)</span></div>
    </div>

    <div class="card-grid-2 section-gap">
      <%# ---------- Duties per month: vertical bars, height set from a 0-100 percent ---------- %>
      <section class="card" aria-labelledby="month-title">
        <h2 id="month-title">Duties per month</h2>
        <% if (monthBars.length === 0) { %>
          <p class="muted">No days in this period have happened yet.</p>
        <% } else { %>
          <ul class="bar-chart-v">
            <% monthBars.forEach((b) => { %>
              <li class="bar-col">
                <span class="bar-value"><%= b.count %></span>
                <span class="bar-col-fill" style="height: <%= b.height %>%" aria-hidden="true"></span>
                <span class="visually-hidden"><%= b.label %>: <%= b.count %> duties</span>
              </li>
            <% }) %>
          </ul>
          <ul class="bar-labels" aria-hidden="true">
            <% monthBars.forEach((b) => { %><li><%= b.label %></li><% }) %>
          </ul>
        <% } %>
      </section>

      <%# ---------- Attendance rate, all officers: horizontal bars, width set from a 0-100 percent ---------- %>
      <section class="card" aria-labelledby="rate-title">
        <h2 id="rate-title">Attendance rate, all officers</h2>
        <% if (rateBars.length === 0) { %>
          <p class="muted">No one is on the duty schedule yet.</p>
        <% } else { %>
          <ul class="bar-list">
            <% rateBars.forEach((b) => { %>
              <li class="bar-row<%= b.selected ? ' bar-row-selected' : '' %>">
                <%- include('../../partials/avatar', { person: b.person, size: 'sm', duty: false }) %>
                <span class="bar-row-name"><%= b.person.first_name %></span>
                <span class="bar-track" aria-hidden="true">
                  <span class="bar-fill<%= b.selected ? ' bar-fill-selected' : (b.low ? ' bar-fill-low' : '') %>" style="width: <%= b.rate %>%"></span>
                </span>
                <%# The number is always printed, so the meaning never depends on colour alone %>
                <span class="bar-row-value"><%= b.rateText %></span>
              </li>
            <% }) %>
          </ul>
          <p class="hint section-gap-sm">Gold = the officer shown above. Red = below 60%.</p>
        <% } %>
      </section>
    </div>
  <% } %>
</main>

<%- include('../../partials/foot') %>
