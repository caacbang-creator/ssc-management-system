<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<%
  // Buttons shown here are a convenience only - every action is checked again on the server
  const a = announcement;
  const canWrite = ['pro', 'president'].includes(currentUser.role);
  const canReview = ['vp_internal', 'president'].includes(currentUser.role);
%>

<main id="main" class="container">
  <a class="back-link" href="/manage/announcements"><span aria-hidden="true">&larr;</span> Announcements</a>

  <div class="page-heading">
    <div>
      <p class="eyebrow"><%= a.category.charAt(0).toUpperCase() + a.category.slice(1) %></p>
      <h1><%= a.title %></h1>
    </div>
    <%- include('../../partials/status-pill', { status: a.status }) %>
  </div>

  <div class="split">
    <div>
      <% if (a.review_remarks) { %>
        <div class="alert alert-info">
          <p><strong>Notes from the reviewer:</strong></p>
          <p class="keep-lines"><%= a.review_remarks %></p>
        </div>
      <% } %>
      <article class="card">
        <p class="keep-lines prose"><%= a.body %></p>
      </article>
      <p class="meta">
        By <%= a.author_name %> &middot; updated <%= formatDate(a.updated_at) %>
        <% if (a.published_at) { %> &middot; published <%= formatDate(a.published_at) %><% } %>
        <% if (a.reviewer_name) { %> &middot; reviewed by <%= a.reviewer_name %><% } %>
      </p>
    </div>

    <aside class="split-aside" aria-labelledby="next-title">
      <div class="card">
        <h2 id="next-title">Next step</h2>
        <%- include('../../partials/steps', {
          steps: ['Draft', 'Waiting for approval', 'Published'],
          current: ['draft', 'pending', 'published'].indexOf(a.status),
          stopped: false
        }) %>

        <% if (a.status === 'draft' && canWrite) { %>
          <p class="hint">Ready? Send it to the VP or President for approval.</p>
          <form method="post" action="/manage/announcements/<%= a.id %>/submit">
            <button type="submit" class="btn btn-primary">Send for approval <span class="arrow" aria-hidden="true">&rarr;</span></button>
          </form>
          <div class="action-row section-gap">
            <a class="btn btn-secondary btn-sm" href="/manage/announcements/<%= a.id %>/edit">Edit draft</a>
            <form method="post" action="/manage/announcements/<%= a.id %>/delete" class="inline-form">
              <button type="submit" class="btn btn-danger btn-sm">Delete draft</button>
            </form>
          </div>
        <% } else if (a.status === 'draft') { %>
          <p class="muted">Still a draft.</p>
        <% } %>

        <% if (a.status === 'pending' && canReview) { %>
          <form method="post" action="/manage/announcements/<%= a.id %>/approve">
            <button type="submit" class="btn btn-primary">Approve and publish <span class="arrow" aria-hidden="true">&rarr;</span></button>
          </form>

          <h3 class="section-gap">Needs changes?</h3>
          <%- include('../../partials/form-errors') %>
          <form method="post" action="/manage/announcements/<%= a.id %>/return" novalidate>
            <div class="form-field">
              <label for="remarks">Remarks</label>
              <textarea id="remarks" name="remarks" rows="3" maxlength="500" aria-describedby="remarks-hint" required><%= oldRemarks %></textarea>
              <p class="hint" id="remarks-hint">Say what should change. Required, up to 500 characters.</p>
            </div>
            <button type="submit" class="btn btn-secondary">Send back with notes</button>
          </form>
        <% } else if (a.status === 'pending') { %>
          <p class="muted">Waiting for the VP for Internal Affairs or the President.</p>
        <% } %>

        <% if (a.status === 'published') { %>
          <p><a class="text-link" href="/announcements/<%= a.id %>">See the public page <span class="arrow" aria-hidden="true">&rarr;</span></a></p>
          <% if (canReview) { %>
            <form method="post" action="/manage/announcements/<%= a.id %>/unpublish">
              <button type="submit" class="btn btn-secondary">Unpublish</button>
            </form>
          <% } %>
        <% } %>
      </div>
    </aside>
  </div>
</main>

<%- include('../../partials/foot') %>
