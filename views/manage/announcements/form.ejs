<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container form-page">
  <a class="back-link" href="/manage/announcements"><span aria-hidden="true">&larr;</span> Announcements</a>

  <section class="card">
    <h1><%= title %></h1>
    <% if (locals.live) { %>
      <div class="alert alert-info" role="note">
        <p><strong>This post is live.</strong> Saving sends it back for approval. It is hidden from
          the News page until a VP for Internal Affairs or the President approves it again.</p>
      </div>
    <% } else { %>
      <p class="muted">Saved as a draft. You can send it for approval afterwards.</p>
    <% } %>

    <% if (remarks) { %>
      <div class="alert alert-info">
        <p><strong>Notes from the reviewer:</strong></p>
        <p class="keep-lines"><%= remarks %></p>
      </div>
    <% } %>

    <%- include('../../partials/form-errors') %>

    <form method="post" action="<%= action %>" novalidate>
      <div class="form-field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= old.title || '' %>" maxlength="150" required>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="category">Category</label>
          <select id="category" name="category">
            <% categories.forEach((c) => { %>
              <option value="<%= c %>"<% if (old.category === c) { %> selected<% } %>><%= c.charAt(0).toUpperCase() + c.slice(1) %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-field">
          <label for="news_date">Date of the news</label>
          <input type="date" id="news_date" name="news_date" value="<%= old.news_date ? String(old.news_date).slice(0, 10) : '' %>"
            aria-describedby="news-date-hint" required>
          <p class="hint" id="news-date-hint">Shown on the post, e.g. the day it was announced. Not in the future.</p>
        </div>
      </div>
      <div class="form-field">
        <label for="body">Announcement text</label>
        <textarea id="body" name="body" rows="10" maxlength="10000" required><%= old.body || '' %></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= locals.live ? 'Save and send for approval' : 'Save draft' %></button>
        <a class="btn btn-secondary" href="/manage/announcements">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include('../../partials/foot') %>
