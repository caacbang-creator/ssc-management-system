<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container form-page">
  <a class="back-link" href="/manage/committees"><span aria-hidden="true">&larr;</span> Committees</a>

  <section class="card">
    <h1><%= title %></h1>
    <%- include('../../partials/form-errors') %>

    <form method="post" action="<%= action %>" novalidate>
      <div class="form-field">
        <label for="name">Committee name</label>
        <input type="text" id="name" name="name" value="<%= old.name || '' %>" maxlength="100" required>
      </div>
      <div class="form-field">
        <label for="description">Description <span class="optional">(optional)</span></label>
        <textarea id="description" name="description" rows="3" maxlength="500"><%= old.description || '' %></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save committee</button>
        <a class="btn btn-secondary" href="/manage/committees">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include('../../partials/foot') %>
