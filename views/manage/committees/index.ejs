<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Officer tools</p>
      <h1>Committees</h1>
      <p class="page-lead">Groups that officers belong to. Shown on the About page.</p>
    </div>
    <a class="btn btn-primary" href="/manage/committees/new">Add a committee <span class="arrow" aria-hidden="true">&rarr;</span></a>
  </div>

  <% if (committees.length === 0) { %>
    <div class="card empty-state">
      <p>No committees yet. Add the first one.</p>
    </div>
  <% } else { %>
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Committee</th>
            <th scope="col">Description</th>
            <th scope="col" class="num">Officers</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% committees.forEach((c) => { %>
            <tr>
              <td><strong><%= c.name %></strong></td>
              <td class="muted"><%= c.description || '' %></td>
              <td class="num"><%= c.officer_count %></td>
              <td class="actions">
                <a class="btn btn-secondary btn-sm" href="/manage/committees/<%= c.id %>/edit">Edit</a>
                <form method="post" action="/manage/committees/<%= c.id %>/delete" class="inline-form">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <div class="page-end">
    <p>Next, put officers in their committees.</p>
    <a class="btn btn-secondary" href="/manage/officers">Officer directory <span class="arrow" aria-hidden="true">&rarr;</span></a>
  </div>
</main>

<%- include('../../partials/foot') %>
