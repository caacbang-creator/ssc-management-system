<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<% const d = doc; %>

<main id="main" class="container">
  <a class="back-link" href="/manage/documents"><span aria-hidden="true">&larr;</span> Documents</a>

  <div class="page-heading">
    <div>
      <p class="eyebrow"><%= d.doc_type.charAt(0).toUpperCase() + d.doc_type.slice(1) %></p>
      <h1><%= d.title %></h1>
    </div>
    <%- include('../../partials/status-pill', { status: d.status }) %>
  </div>

  <div class="split">
    <div>
      <% if (d.review_remarks) { %>
        <div class="alert alert-info">
          <p><strong>Notes from the President:</strong></p>
          <p class="keep-lines"><%= d.review_remarks %></p>
        </div>
      <% } %>
      <article class="card">
        <p class="keep-lines prose"><%= d.body %></p>
      </article>
      <p class="meta">
        By <%= d.author_name %> &middot; updated <%= formatDate(d.updated_at) %>
        <% if (d.reviewer_name) { %> &middot; reviewed by <%= d.reviewer_name %><% } %>
      </p>
    </div>

    <aside class="split-aside" aria-label="Next step">
      <%- include('../../partials/review-actions', {
        base: '/manage/documents', id: d.id, status: d.status, label: 'document',
        canWrite: ['secretary', 'president'].includes(currentUser.role),
        canPublish: currentUser.role === 'president',
        publicUrl: '/documents/other/' + d.id
      }) %>
    </aside>
  </div>
</main>

<%- include('../../partials/foot') %>
