<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<%
  const canWrite = ['secretary', 'president'].includes(currentUser.role);
  const filters = [
    { value: '', label: 'All' },
    { value: 'pending', label: 'With the President' },
    { value: 'draft', label: 'Drafts' },
    { value: 'published', label: 'Published' }
  ];
%>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Officer tools</p>
      <h1>Resolutions</h1>
      <p class="page-lead"><%= canWrite ? 'Record what the council decided.' : 'You can view these, but not edit them.' %></p>
    </div>
    <% if (canWrite) { %>
      <a class="btn btn-primary" href="/manage/resolutions/new">Write a resolution <span class="arrow" aria-hidden="true">&rarr;</span></a>
    <% } %>
  </div>

  <nav aria-label="Filter by status">
    <ul class="filter-links">
      <% filters.forEach((f) => { %>
        <li><a href="/manage/resolutions<%= f.value ? '?status=' + f.value : '' %>"<% if (status === f.value) { %> aria-current="page"<% } %>><%= f.label %></a></li>
      <% }) %>
    </ul>
  </nav>

  <% if (resolutions.length === 0) { %>
    <div class="card empty-state"><p><%= status ? 'Nothing here right now.' : 'No resolutions yet.' %></p></div>
  <% } else { %>
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Title</th>
            <th scope="col">Status</th>
            <th scope="col">Number</th>
            <th scope="col">Adopted</th>
          </tr>
        </thead>
        <tbody>
          <% resolutions.forEach((r) => { %>
            <tr>
              <td><a href="/manage/resolutions/<%= r.id %>"><%= r.title %></a></td>
              <td><%- include('../../partials/status-pill', { status: r.status }) %></td>
              <td class="muted"><%= r.resolution_no %></td>
              <td><%= formatDate(r.date_adopted) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../../partials/foot') %>
