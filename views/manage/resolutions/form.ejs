<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container form-page">
  <a class="back-link" href="/manage/resolutions"><span aria-hidden="true">&larr;</span> Resolutions</a>

  <section class="card">
    <h1><%= title %></h1>
    <p class="muted">Saved as a draft. You can send it to the President afterwards.</p>

    <% if (remarks) { %>
      <div class="alert alert-info">
        <p><strong>Notes from the President:</strong></p>
        <p class="keep-lines"><%= remarks %></p>
      </div>
    <% } %>

    <%- include('../../partials/form-errors') %>

    <form method="post" action="<%= action %>" novalidate>
      <div class="form-field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= old.title || '' %>" maxlength="150" required>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="resolution_no">Resolution number</label>
          <input type="text" id="resolution_no" name="resolution_no" value="<%= old.resolution_no || '' %>"
            maxlength="30" aria-describedby="number-hint" placeholder="SSC-RES-2026-002" required>
          <p class="hint" id="number-hint">Like SSC-RES-2026-002</p>
        </div>
        <div class="form-field">
          <label for="date_adopted">Date adopted</label>
          <input type="date" id="date_adopted" name="date_adopted" value="<%= old.date_adopted || '' %>"
            max="<%= maxDate %>" required>
        </div>
      </div>
      <div class="form-field">
        <label for="body">Resolution text</label>
        <textarea id="body" name="body" rows="10" maxlength="10000" required><%= old.body || '' %></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save draft</button>
        <a class="btn btn-secondary" href="/manage/resolutions">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include('../../partials/foot') %>
