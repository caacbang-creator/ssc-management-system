<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container form-page">
  <a class="back-link" href="/manage/events"><span aria-hidden="true">&larr;</span> Events</a>

  <section class="card">
    <h1><%= title %></h1>
    <p class="muted">Saved as a draft. You can send it for approval afterwards.</p>

    <% if (remarks) { %>
      <div class="alert alert-info">
        <p><strong>Notes from the reviewer:</strong></p>
        <p class="keep-lines"><%= remarks %></p>
      </div>
    <% } %>

    <%- include('../../partials/form-errors') %>

    <form method="post" action="<%= action %>" novalidate>
      <div class="form-field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= old.title || '' %>" maxlength="150" required>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="event_date">Date</label>
          <input type="date" id="event_date" name="event_date" value="<%= old.event_date || '' %>" min="<%= minDate %>" required>
        </div>
        <div class="form-field">
          <label for="start_time">Start time</label>
          <input type="time" id="start_time" name="start_time" value="<%= old.start_time || '' %>" required>
        </div>
        <div class="form-field">
          <label for="end_time">End time <span class="optional">(optional)</span></label>
          <input type="time" id="end_time" name="end_time" value="<%= old.end_time || '' %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="venue">Venue</label>
          <input type="text" id="venue" name="venue" value="<%= old.venue || '' %>" maxlength="150" required>
        </div>
        <div class="form-field">
          <label for="capacity">Capacity</label>
          <input type="text" id="capacity" name="capacity" value="<%= old.capacity || '' %>" inputmode="numeric"
            maxlength="4" aria-describedby="capacity-hint" required>
          <p class="hint" id="capacity-hint">How many can join (1 to 9999)</p>
        </div>
      </div>
      <div class="form-field">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="6" maxlength="5000" required><%= old.description || '' %></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save draft</button>
        <a class="btn btn-secondary" href="/manage/events">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include('../../partials/foot') %>
