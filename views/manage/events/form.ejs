<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container form-page">
  <a class="back-link" href="/manage/events"><span aria-hidden="true">&larr;</span> Events</a>

  <section class="card">
    <h1><%= title %></h1>
    <% if (locals.live) { %>
      <div class="alert alert-info" role="note">
        <p><strong>This event is live.</strong> Saving sends it back for approval. It is hidden from
          the Events page (and registration pauses) until a VP for Internal Affairs or the President approves it.</p>
      </div>
    <% } else { %>
      <p class="muted">Saved as a draft. You can send it for approval afterwards.</p>
    <% } %>

    <% if (remarks) { %>
      <div class="alert alert-info">
        <p><strong>Notes from the reviewer:</strong></p>
        <p class="keep-lines"><%= remarks %></p>
      </div>
    <% } %>

    <%- include('../../partials/form-errors') %>

    <form method="post" action="<%= action %>" novalidate>
      <div class="form-field">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= old.title || '' %>" maxlength="150" required>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="event_date">Date</label>
          <input type="date" id="event_date" name="event_date" value="<%= old.event_date || '' %>"
            aria-describedby="date-hint" required>
          <p class="hint" id="date-hint">A past date is fine for an event that already happened. Once it is approved, mark it completed to add photos and a write-up.</p>
        </div>
        <div class="form-field">
          <label for="start_time">Start time</label>
          <input type="time" id="start_time" name="start_time" value="<%= old.start_time || '' %>" required>
        </div>
        <div class="form-field">
          <label for="end_time">End time <span class="optional">(optional)</span></label>
          <input type="time" id="end_time" name="end_time" value="<%= old.end_time || '' %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="venue">Venue <span class="optional">(optional)</span></label>
          <input type="text" id="venue" name="venue" value="<%= old.venue || '' %>" maxlength="150" aria-describedby="venue-hint">
          <p class="hint" id="venue-hint">Leave empty if not decided yet. It shows as "To be announced".</p>
        </div>
        <div class="form-field">
          <label for="capacity">Capacity <span class="optional">(optional)</span></label>
          <input type="text" id="capacity" name="capacity" value="<%= old.capacity || '' %>" inputmode="numeric"
            maxlength="4" aria-describedby="capacity-hint">
          <p class="hint" id="capacity-hint">How many can join (1 to 9999). Leave empty for no limit.</p>
        </div>
      </div>
      <div class="form-field">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="6" maxlength="5000" required><%= old.description || '' %></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= locals.live ? 'Save and send for approval' : 'Save draft' %></button>
        <a class="btn btn-secondary" href="/manage/events">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include('../../partials/foot') %>
