<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container form-page">
  <a class="back-link" href="/manage/events/<%= event.id %>"><span aria-hidden="true">&larr;</span> Back to the event</a>

  <section class="card danger-card" aria-labelledby="remove-title">
    <p class="eyebrow">President only</p>
    <h1 id="remove-title">Delete this event permanently?</h1>
    <p class="lead-text"><strong><%= event.title %></strong> &middot; <%= formatDate(event.event_date) %></p>

    <div class="alert alert-error" role="alert">
      <p><strong>This cannot be undone.</strong> The following will be deleted for good:</p>
      <ul>
        <li>the event and its write-up</li>
        <li><%= event.registered_count %> student registration<%= event.registered_count === 1 ? '' : 's' %></li>
        <li><%= photoCount %> photo<%= photoCount === 1 ? '' : 's' %> and <%= videoCount %> video<%= videoCount === 1 ? '' : 's' %></li>
      </ul>
    </div>

    <% if (event.status === 'published') { %>
      <p class="hint">Only want it off the Events page? <strong>Cancel</strong> it instead: students are told it was cancelled and the record is kept.</p>
    <% } %>

    <div class="form-actions">
      <form method="post" action="/manage/events/<%= event.id %>/remove" class="inline-form">
        <button type="submit" class="btn btn-danger">Delete permanently</button>
      </form>
      <a class="btn btn-secondary" href="/manage/events/<%= event.id %>">Keep it</a>
    </div>
  </section>
</main>

<%- include('../../partials/foot') %>
