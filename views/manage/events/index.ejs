<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<%
  const canWrite = ['pro', 'president'].includes(currentUser.role);
  const filters = [
    { value: '', label: 'All' },
    { value: 'pending', label: 'Waiting for approval' },
    { value: 'draft', label: 'Drafts' },
    { value: 'published', label: 'Published' },
    { value: 'completed', label: 'Completed' },
    { value: 'cancelled', label: 'Cancelled' }
  ];
%>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Officer tools</p>
      <h1>Events</h1>
      <p class="page-lead">Plan events, get them approved and see who's coming.</p>
    </div>
    <% if (canWrite) { %>
      <a class="btn btn-primary" href="/manage/events/new">Plan an event <span class="arrow" aria-hidden="true">&rarr;</span></a>
    <% } %>
  </div>

  <nav aria-label="Filter by status">
    <ul class="filter-links">
      <% filters.forEach((f) => { %>
        <li><a href="/manage/events<%= f.value ? '?status=' + f.value : '' %>"<% if (status === f.value) { %> aria-current="page"<% } %>><%= f.label %></a></li>
      <% }) %>
    </ul>
  </nav>

  <% if (events.length === 0) { %>
    <div class="card empty-state">
      <p><%= status ? 'Nothing here right now.' : 'No events yet.' %></p>
    </div>
  <% } else { %>
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Event</th>
            <th scope="col">Status</th>
            <th scope="col">Date</th>
            <th scope="col" class="num">Signed up</th>
          </tr>
        </thead>
        <tbody>
          <% events.forEach((e) => { %>
            <tr>
              <td><a href="/manage/events/<%= e.id %>"><%= e.title %></a></td>
              <td><%- include('../../partials/status-pill', { status: e.status }) %></td>
              <td><%= formatDate(e.event_date) %></td>
              <td class="num"><%= e.registered_count %><%= e.capacity === null ? ' (no limit)' : ' / ' + e.capacity %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../../partials/foot') %>
