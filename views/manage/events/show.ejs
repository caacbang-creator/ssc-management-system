<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<%
  // Buttons shown here are a convenience only - every action is checked again on the server
  const e = event;
  const canWrite = ['pro', 'president'].includes(currentUser.role);
  const canReview = ['vp_internal', 'president'].includes(currentUser.role);
  const flow = ['draft', 'pending', 'published', 'completed'];
  const stopped = e.status === 'cancelled';
  const steps = stopped ? ['Draft', 'Approved', 'Cancelled'] : ['Draft', 'Waiting for approval', 'Published', 'Completed'];
  const current = stopped ? 2 : flow.indexOf(e.status);
%>

<main id="main" class="container">
  <a class="back-link" href="/manage/events"><span aria-hidden="true">&larr;</span> Events</a>

  <div class="page-heading">
    <div>
      <h1><%= e.title %></h1>
      <p class="page-lead"><%= formatDate(e.event_date) %> &middot; <%= formatTime(e.start_time) %><% if (e.end_time) { %> &ndash; <%= formatTime(e.end_time) %><% } %> &middot; <%= e.venue || 'Venue to be announced' %></p>
    </div>
    <%- include('../../partials/status-pill', { status: e.status }) %>
  </div>

  <div class="split">
    <div>
      <% if (e.review_remarks) { %>
        <div class="alert alert-info">
          <p><strong>Notes from the reviewer:</strong></p>
          <p class="keep-lines"><%= e.review_remarks %></p>
        </div>
      <% } %>

      <a class="card stat-card" href="/manage/events/<%= e.id %>/registrants">
        <span class="stat-number"><%= e.registered_count %><%= e.capacity === null ? '' : ' / ' + e.capacity %></span>
        <span class="stat-label">Signed up &middot; see the list <span class="arrow" aria-hidden="true">&rarr;</span></span>
      </a>

      <article class="card section-gap">
        <h2>Description</h2>
        <p class="keep-lines prose"><%= e.description %></p>
      </article>

      <% if (e.status === 'completed') { %>
        <section class="card">
          <h2>How it went</h2>
          <% if (e.documentation) { %>
            <p class="keep-lines prose"><%= e.documentation %></p>
          <% } else { %>
            <p class="muted">Nothing written yet.</p>
          <% } %>
        </section>
      <% } %>

      <p class="meta">
        By <%= e.author_name %> &middot; updated <%= formatDate(e.updated_at) %>
        <% if (e.reviewer_name) { %> &middot; reviewed by <%= e.reviewer_name %><% } %>
      </p>
    </div>

    <aside class="split-aside" aria-labelledby="next-title">
      <div class="card">
        <h2 id="next-title">Next step</h2>
        <%- include('../../partials/steps', { steps, current, stopped }) %>

        <% if (e.status === 'draft' && canWrite) { %>
          <p class="hint">Ready? Send it to the VP or President for approval.</p>
          <form method="post" action="/manage/events/<%= e.id %>/submit">
            <button type="submit" class="btn btn-primary">Send for approval <span class="arrow" aria-hidden="true">&rarr;</span></button>
          </form>
          <div class="action-row section-gap">
            <a class="btn btn-secondary btn-sm" href="/manage/events/<%= e.id %>/edit">Edit draft</a>
            <form method="post" action="/manage/events/<%= e.id %>/delete" class="inline-form">
              <button type="submit" class="btn btn-danger btn-sm">Delete draft</button>
            </form>
          </div>
        <% } else if (e.status === 'draft') { %>
          <p class="muted">Still a draft.</p>
        <% } %>

        <% if (e.status === 'pending' && canReview) { %>
          <form method="post" action="/manage/events/<%= e.id %>/approve">
            <button type="submit" class="btn btn-primary">Approve and publish <span class="arrow" aria-hidden="true">&rarr;</span></button>
          </form>

          <h3 class="section-gap">Needs changes?</h3>
          <%- include('../../partials/form-errors') %>
          <form method="post" action="/manage/events/<%= e.id %>/return" novalidate>
            <div class="form-field">
              <label for="remarks">Remarks</label>
              <textarea id="remarks" name="remarks" rows="3" maxlength="500" aria-describedby="remarks-hint" required><%= oldRemarks %></textarea>
              <p class="hint" id="remarks-hint">Say what should change. Required, up to 500 characters.</p>
            </div>
            <button type="submit" class="btn btn-secondary">Send back with notes</button>
          </form>
        <% } else if (e.status === 'pending') { %>
          <p class="muted">Waiting for the VP for Internal Affairs or the President.</p>
        <% } %>

        <% if (e.status === 'published') { %>
          <p><a class="text-link" href="/events/<%= e.id %>">See the public page <span class="arrow" aria-hidden="true">&rarr;</span></a></p>
          <% if (canWrite) { %>
            <% if (e.event_date <= today) { %>
              <form method="post" action="/manage/events/<%= e.id %>/complete">
                <button type="submit" class="btn btn-primary">Mark as completed</button>
              </form>
            <% } else { %>
              <p class="hint">You can mark it completed on or after <%= formatDate(e.event_date) %>.</p>
            <% } %>
            <p class="hint section-gap">Editing a live event sends it back for approval.</p>
            <a class="btn btn-secondary btn-sm" href="/manage/events/<%= e.id %>/edit">Edit event</a>
          <% } %>
          <% if (canReview) { %>
            <form method="post" action="/manage/events/<%= e.id %>/cancel" class="section-gap">
              <button type="submit" class="btn btn-danger btn-sm">Cancel event</button>
            </form>
          <% } %>
        <% } %>

        <% if (e.status === 'completed' && canWrite) { %>
          <a class="btn btn-primary" href="/manage/events/<%= e.id %>/documentation"><%= e.documentation ? 'Edit the write-up' : 'Write how it went' %></a>
        <% } %>
        <% if (e.status === 'cancelled') { %>
          <p class="muted">This event was cancelled.</p>
        <% } %>
      </div>

      <%# President only (C23): leads to a confirmation page, nothing is deleted yet %>
      <% if (currentUser.role === 'president' && ['published', 'completed', 'cancelled'].includes(e.status)) { %>
        <div class="card">
          <h2 class="aside-title">Delete the event</h2>
          <p class="hint">Removes it for good, with its registrations, photos and videos.</p>
          <a class="btn btn-danger btn-sm" href="/manage/events/<%= e.id %>/remove">Delete permanently&hellip;</a>
        </div>
      <% } %>

      <%# Always visible to the PRO / President, so they know where uploads are and when they open %>
      <% if (canWrite) { %>
        <div class="card">
          <h2 class="aside-title">Photos and videos</h2>
          <% if (e.status === 'draft' || e.status === 'completed') { %>
            <p class="hint">
              <%= e.status === 'draft'
                ? 'Prepare them now. Students see them once the event is completed.'
                : 'Shown on the public event page.' %>
            </p>
            <a class="btn btn-secondary" href="/manage/events/<%= e.id %>/photos">Upload photos and videos <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <% } else if (e.status === 'cancelled') { %>
            <p class="muted">Not available for a cancelled event.</p>
          <% } else { %>
            <p class="muted">
              Locked while the event is <%= e.status === 'pending' ? 'waiting for approval' : 'live' %>.
              They open again once it is marked completed<%= e.status === 'published' && e.event_date > today ? ' (on or after ' + formatDate(e.event_date) + ')' : '' %>.
            </p>
          <% } %>
        </div>
      <% } %>
    </aside>
  </div>
</main>

<%- include('../../partials/foot') %>
