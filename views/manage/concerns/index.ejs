<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<%
  // Ordered by urgency: new ones first
  const filters = [
    { value: '', label: 'All' },
    { value: 'submitted', label: 'New' },
    { value: 'under_review', label: 'Under review' },
    { value: 'responded', label: 'Answered' },
    { value: 'resolved', label: 'Resolved' }
  ];
%>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Officer tools</p>
      <h1>Concerns</h1>
      <p class="page-lead">Read what students sent, reply, and close them when fixed.</p>
    </div>
    <% if (status !== 'submitted') { %>
      <a class="btn btn-primary" href="/manage/concerns?status=submitted">See new concerns <span class="arrow" aria-hidden="true">&rarr;</span></a>
    <% } %>
  </div>

  <nav aria-label="Filter by status">
    <ul class="filter-links">
      <% filters.forEach((f) => { %>
        <li><a href="/manage/concerns<%= f.value ? '?status=' + f.value : '' %>"<% if (status === f.value) { %> aria-current="page"<% } %>><%= f.label %></a></li>
      <% }) %>
    </ul>
  </nav>

  <% if (concerns.length === 0) { %>
    <div class="card empty-state">
      <p><%= status ? 'Nothing here right now.' : 'No concerns yet.' %></p>
    </div>
  <% } else { %>
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Subject</th>
            <th scope="col">Status</th>
            <th scope="col">Category</th>
            <th scope="col">From</th>
            <th scope="col">Sent</th>
            <th scope="col">Code</th>
          </tr>
        </thead>
        <tbody>
          <% concerns.forEach((c) => { %>
            <tr>
              <td><a href="/manage/concerns/<%= c.id %>"><%= c.subject %></a></td>
              <td><%- include('../../partials/status-pill', { status: c.status }) %></td>
              <td><%= (c.category.charAt(0).toUpperCase() + c.category.slice(1)).replace('_', ' ') %></td>
              <td><%= c.is_anonymous ? 'Anonymous' : 'Named' %></td>
              <td><%= formatDate(c.created_at) %></td>
              <td class="muted"><%= c.reference_no %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../../partials/foot') %>
