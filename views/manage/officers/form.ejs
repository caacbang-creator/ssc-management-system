<%- include('../../partials/head') %>
<%- include('../../partials/nav') %>

<main id="main" class="container form-page">
  <a class="back-link" href="/manage/officers"><span aria-hidden="true">&larr;</span> Officer directory</a>

  <section class="card">
    <h1><%= title %></h1>
    <%- include('../../partials/form-errors') %>

    <form method="post" action="<%= action %>" novalidate>
      <div class="form-field">
        <label for="full_name">Full name</label>
        <input type="text" id="full_name" name="full_name" value="<%= old.full_name || '' %>" maxlength="120" required>
      </div>
      <div class="form-field">
        <label for="position">Position</label>
        <input type="text" id="position" name="position" value="<%= old.position || '' %>" maxlength="100"
          aria-describedby="position-hint" required>
        <p class="hint" id="position-hint">For example: Treasurer, Committee Head</p>
      </div>
      <div class="form-field">
        <label for="committee_id">Committee <span class="optional">(optional)</span></label>
        <select id="committee_id" name="committee_id">
          <option value="">None</option>
          <% committees.forEach((c) => { %>
            <option value="<%= c.id %>"<% if (String(c.id) === (old.committee_id || '')) { %> selected<% } %>><%= c.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-row">
        <div class="form-field">
          <label for="term">Term</label>
          <input type="text" id="term" name="term" value="<%= old.term || '' %>" maxlength="9"
            aria-describedby="term-hint" placeholder="2026-2027" required>
          <p class="hint" id="term-hint">Like 2026-2027</p>
        </div>
        <div class="form-field">
          <label for="sort_order">Display order <span class="optional">(optional)</span></label>
          <input type="text" id="sort_order" name="sort_order" value="<%= old.sort_order || '' %>"
            inputmode="numeric" maxlength="3" aria-describedby="order-hint">
          <p class="hint" id="order-hint">0 to 999. Lower shows first.</p>
        </div>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save officer</button>
        <a class="btn btn-secondary" href="/manage/officers">Cancel</a>
      </div>
    </form>
  </section>
</main>

<%- include('../../partials/foot') %>
