<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
  const count = (statuses) => concerns.filter((c) => statuses.includes(c.status)).length;
  const summary = [
    ['Waiting', count(['submitted', 'under_review']), 'search'],
    ['Replied', count(['responded']), 'reply'],
    ['Resolved', count(['resolved']), 'check']
  ];
%>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Concerns</p>
      <h1>My concerns</h1>
      <p class="page-lead">Anonymous ones aren't listed here. <a href="/concerns/track">Track them with your code</a>.</p>
    </div>
    <a class="btn btn-primary" href="/concerns/new">Raise a concern <span class="arrow" aria-hidden="true">&rarr;</span></a>
  </div>

  <% if (concerns.length === 0) { %>
    <div class="card empty-state empty-state-big">
      <span class="icon-tile"><%- include('../partials/icon', { name: 'check' }) %></span>
      <p><strong>No concerns yet.</strong> We hope that means all is well!</p>
      <a class="btn btn-secondary" href="/concerns/new">Raise one</a>
    </div>
  <% } else { %>
    <div class="summary-row">
      <% summary.forEach(([label, number, icon]) => { %>
        <div class="card summary-chip">
          <span class="icon-tile icon-tile-sm"><%- include('../partials/icon', { name: icon }) %></span>
          <span><span class="stat-number"><%= number %></span> <span class="stat-label"><%= label %></span></span>
        </div>
      <% }) %>
    </div>

    <h2 class="visually-hidden">All my concerns, newest first</h2>
    <div class="concern-list">
      <% concerns.forEach((c) => { %>
        <%- include('../partials/concern-card', { c }) %>
      <% }) %>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
