<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Concerns</p>
      <h1>My concerns</h1>
      <p class="page-lead">Anonymous ones aren't listed here. <a href="/concerns/track">Track them with your code</a>.</p>
    </div>
    <a class="btn btn-primary" href="/concerns/new">Raise a concern <span class="arrow" aria-hidden="true">&rarr;</span></a>
  </div>

  <% if (concerns.length === 0) { %>
    <div class="card empty-state">
      <p>You haven't sent any concerns yet. We hope that means all is well!</p>
    </div>
  <% } else { %>
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Subject</th>
            <th scope="col">Status</th>
            <th scope="col">Sent</th>
            <th scope="col">Code</th>
          </tr>
        </thead>
        <tbody>
          <% concerns.forEach((c) => { %>
            <tr>
              <td><a href="/concerns/<%= c.id %>"><%= c.subject %></a></td>
              <td><%- include('../partials/status-pill', { status: c.status }) %></td>
              <td><%= formatDate(c.created_at) %></td>
              <td class="muted"><%= c.reference_no %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
