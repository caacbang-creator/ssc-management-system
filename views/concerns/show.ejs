<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
  const concernSteps = ['Received', 'Being reviewed', 'We replied', 'Resolved'];
  const stepIndex = ['submitted', 'under_review', 'responded', 'resolved'].indexOf(concern.status);
  const info = categoryInfo[concern.category] || categoryInfo.other;
%>

<main id="main" class="container">
  <a class="back-link" href="/concerns/my"><span aria-hidden="true">&larr;</span> My concerns</a>

  <div class="page-heading">
    <div>
      <p class="eyebrow"><%= info.label %> &middot; <%= concern.reference_no %></p>
      <h1><%= concern.subject %></h1>
      <p class="page-lead">Sent <%= formatDate(concern.created_at) %></p>
    </div>
    <%- include('../partials/status-pill', { status: concern.status }) %>
  </div>

  <section class="card" aria-labelledby="progress-title">
    <h2 id="progress-title" class="visually-hidden">Progress</h2>
    <div class="steps-wide">
      <%- include('../partials/steps', { steps: concernSteps, current: stepIndex, stopped: false }) %>
    </div>
  </section>

  <div class="card-grid-2 section-gap">
    <%# Our reply is what the student came back for, so it comes first %>
    <section class="card reply-card<%= concern.response ? ' has-reply' : '' %>" aria-labelledby="reply-title">
      <div class="reply-head">
        <span class="icon-tile"><%- include('../partials/icon', { name: 'reply' }) %></span>
        <div>
          <h2 id="reply-title">Our reply</h2>
          <% if (concern.response) { %>
            <p class="meta">Replied <%= formatDate(concern.responded_at) %></p>
          <% } %>
        </div>
      </div>
      <% if (concern.response) { %>
        <p class="keep-lines prose"><%= concern.response %></p>
      <% } else { %>
        <p class="muted">No reply yet. We'll post it here as soon as we can.</p>
      <% } %>
    </section>

    <section class="card" aria-labelledby="sent-title">
      <div class="reply-head">
        <span class="icon-tile"><%- include('../partials/icon', { name: info.icon }) %></span>
        <div>
          <h2 id="sent-title">What you sent</h2>
          <p class="meta"><%= info.label %> &middot; <%= formatDate(concern.created_at) %></p>
        </div>
      </div>
      <p class="keep-lines prose"><%= concern.message %></p>
    </section>
  </div>
</main>

<%- include('../partials/foot') %>
