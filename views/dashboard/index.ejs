<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
  // Officer tasks with something waiting come first; the zero ones go to the end
  const sortedTasks = tasks.slice().sort((a, b) => (b.count > 0) - (a.count > 0));
  const waiting = tasks.reduce((sum, t) => sum + Number(t.count), 0);

  // Icon for a task, chosen from the page it links to
  const taskIcon = (href) => {
    if (href.includes('announcements')) return 'megaphone';
    if (href.includes('events')) return 'calendar';
    if (href.includes('concerns')) return 'chat';
    if (href.includes('transactions')) return 'clipboard';
    if (href.includes('financial')) return 'money';
    if (href.includes('officer-requests')) return 'users';
    return 'file';
  };

  const quickActions = [
    ['Make a request', '/transactions/new', 'clipboard'],
    ['Raise a concern', '/concerns/new', 'chat'],
    ['Track a concern', '/concerns/track', 'search'],
    ['Borrow items', '/items', 'box'],
    ['Browse events', '/events', 'calendar'],
    ['SSC documents', '/documents', 'file']
  ];

  let countdown = '';
  if (nextEvent) {
    if (nextEvent.days_left === 0) countdown = 'Today!';
    else if (nextEvent.days_left === 1) countdown = 'Tomorrow';
    else countdown = `In ${nextEvent.days_left} days`;
  }
%>

<main id="main">
  <%# ---------- Hero: greeting over the latest event photo ---------- %>
  <section class="photo-hero" aria-labelledby="hello-title">
    <% if (heroPhoto) { %>
      <img class="photo-hero-img" src="<%= heroPhoto %>" alt="">
    <% } %>
    <div class="container photo-hero-inner fade-up">
      <p class="photo-hero-meta">
        <span><%= todayText %></span>
        <span class="dash-role"><%= roleLabels[currentUser.role] %></span>
      </p>
      <h1 id="hello-title"><%= hello %>, <span class="hero-accent"><%= currentUser.first_name %></span>!</h1>
      <% if (currentUser.officer_request_status === 'pending') { %>
        <p class="photo-hero-lead">Your officer role request is waiting for the President.</p>
      <% } else if (tasks.length > 0) { %>
        <p class="photo-hero-lead"><%= waiting === 0 ? 'You\'re all caught up. Nice work!' : waiting + (waiting === 1 ? ' thing needs' : ' things need') + ' your attention.' %></p>
      <% } else { %>
        <p class="photo-hero-lead">Here's what's happening at the SSC.</p>
      <% } %>
      <div class="action-row">
        <a class="btn btn-light" href="/transactions/new">Make a request <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <a class="btn btn-outline-light" href="/profile">My profile</a>
      </div>
    </div>
  </section>

  <div class="container">
    <%# ---------- My numbers, overlapping the bottom of the hero ---------- %>
    <h2 class="visually-hidden">My activity</h2>
    <div class="dash-stats fade-up fade-up-delay-1">
      <a class="card stat-card dash-stat" href="/transactions">
        <span class="icon-tile"><%- include('../partials/icon', { name: 'clipboard' }) %></span>
        <span>
          <span class="stat-number"><%= summary.active_requests %></span>
          <span class="stat-label">Requests in progress</span>
        </span>
      </a>
      <a class="card stat-card dash-stat" href="/events/my-registrations">
        <span class="icon-tile"><%- include('../partials/icon', { name: 'calendar' }) %></span>
        <span>
          <span class="stat-number"><%= summary.upcoming_events %></span>
          <span class="stat-label">Events I'm going to</span>
        </span>
      </a>
      <a class="card stat-card dash-stat" href="/concerns/my">
        <span class="icon-tile"><%- include('../partials/icon', { name: 'chat' }) %></span>
        <span>
          <span class="stat-number"><%= summary.open_concerns %></span>
          <span class="stat-label">Open concerns</span>
        </span>
      </a>
    </div>

    <%# ---------- Officers: their to-do list ---------- %>
    <% if (tasks.length > 0) { %>
      <section class="section-gap" aria-labelledby="tasks-heading">
        <div class="section-heading">
          <h2 id="tasks-heading">Your to-do list</h2>
        </div>
        <% if (waiting === 0) { %>
          <div class="card dash-caught-up">
            <span class="icon-tile"><%- include('../partials/icon', { name: 'check' }) %></span>
            <p><strong>All caught up.</strong> Nothing is waiting for you right now.</p>
          </div>
        <% } %>
        <div class="card-grid">
          <% sortedTasks.forEach((t) => { %>
            <a class="card stat-card dash-task<%= t.count > 0 ? ' stat-card-active' : '' %>" href="<%= t.href %>">
              <span class="dash-task-top">
                <span class="icon-tile icon-tile-sm"><%- include('../partials/icon', { name: taskIcon(t.href) }) %></span>
                <span class="stat-number"><%= t.count %></span>
              </span>
              <span class="stat-label"><%= t.label %></span>
            </a>
          <% }) %>
        </div>
        <h3 class="section-gap">Go to</h3>
        <ul class="chip-list">
          <% officerLinks.forEach(([label, href]) => { %>
            <li><a href="<%= href %>"><%= label %></a></li>
          <% }) %>
        </ul>
      </section>
    <% } %>

    <%# ---------- Next event spotlight + quick actions ---------- %>
    <div class="dash-split section-gap">
      <section class="card dash-next" aria-labelledby="next-heading">
        <p class="eyebrow" id="next-heading">Next up</p>
        <% if (!nextEvent) { %>
          <p class="muted">No events scheduled yet. We'll post them on the Events page first.</p>
          <a class="text-link" href="/events">See past events <span class="arrow" aria-hidden="true">&rarr;</span></a>
        <% } else { %>
          <% const badge = dateBadge(nextEvent.event_date); %>
          <div class="dash-next-body">
            <span class="date-badge date-badge-lg" aria-hidden="true">
              <span class="date-badge-month"><%= badge.month %></span>
              <span class="date-badge-day"><%= badge.day %></span>
            </span>
            <div>
              <p class="dash-countdown"><%= countdown %></p>
              <h2><a href="/events/<%= nextEvent.id %>"><%= nextEvent.title %></a></h2>
              <p class="meta"><%= formatDate(nextEvent.event_date) %> &middot; <%= formatTime(nextEvent.start_time) %> &middot; <%= nextEvent.venue %></p>
            </div>
          </div>
          <% if (nextEvent.registered) { %>
            <p class="dash-going"><span class="icon-tile icon-tile-sm"><%- include('../partials/icon', { name: 'check' }) %></span> You're in! See you there.</p>
          <% } else { %>
            <a class="btn btn-primary" href="/events/<%= nextEvent.id %>">Save my spot <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <% } %>
        <% } %>
      </section>

      <section class="card" aria-labelledby="quick-heading">
        <p class="eyebrow" id="quick-heading">Quick actions</p>
        <ul class="quick-grid">
          <% quickActions.forEach(([label, href, icon]) => { %>
            <li>
              <a class="quick-tile" href="<%= href %>">
                <span class="icon-tile icon-tile-sm"><%- include('../partials/icon', { name: icon }) %></span>
                <span><%= label %></span>
              </a>
            </li>
          <% }) %>
        </ul>
      </section>
    </div>

    <%# ---------- Latest news posters ---------- %>
    <section class="section-gap" aria-labelledby="news-heading">
      <div class="section-heading">
        <h2 id="news-heading">Latest news</h2>
        <a class="text-link" href="/announcements">All news <span class="arrow" aria-hidden="true">&rarr;</span></a>
      </div>
      <% if (announcements.length === 0) { %>
        <div class="card empty-state"><p>Nothing new right now. Check back soon.</p></div>
      <% } else { %>
        <div class="dash-news">
          <% announcements.forEach((a) => { %>
            <a class="card link-card dash-news-card" href="/announcements/<%= a.id %>">
              <% if (a.cover_path) { %>
                <span class="poster-frame"><img src="<%= a.cover_path %>" alt="" loading="lazy"></span>
              <% } else { %>
                <span class="poster-frame dash-news-empty"><span class="icon-tile"><%- include('../partials/icon', { name: 'megaphone' }) %></span></span>
              <% } %>
              <span class="meta"><%= formatDate(a.published_at) %></span>
              <h3><%= a.title %></h3>
            </a>
          <% }) %>
        </div>
      <% } %>
    </section>

    <%# ---------- Photos from recent events ---------- %>
    <% if (photos.length > 0) { %>
      <section class="section-gap" aria-labelledby="photos-heading">
        <div class="section-heading">
          <h2 id="photos-heading">From our events</h2>
          <a class="text-link" href="/events">All events <span class="arrow" aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="photo-strip">
          <% photos.forEach((p) => { %>
            <a class="photo-strip-item" href="/events/<%= p.event_id %>#photos">
              <img src="<%= p.file_path %>" alt="<%= p.caption || `Photo from ${p.title}` %>" loading="lazy">
              <span class="photo-strip-label"><%= p.title %></span>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <div class="page-end">
      <p>Something bothering you on campus?</p>
      <a class="btn btn-secondary" href="/concerns/new">Raise a concern <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</main>

<%- include('../partials/foot') %>
