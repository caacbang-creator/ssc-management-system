<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
  // Officers: only the tasks that have something waiting are listed
  const waitingTasks = tasks.filter((t) => t.count > 0);
  const waiting = tasks.reduce((sum, t) => sum + t.count, 0);
  const isOfficer = tasks.length > 0;

  // Icon for a task, chosen from the page it links to
  const taskIcon = (href) => {
    if (href.includes('announcements')) return 'megaphone';
    if (href.includes('events')) return 'calendar';
    if (href.includes('concerns')) return 'chat';
    if (href.includes('transactions')) return 'clipboard';
    if (href.includes('items')) return 'box';
    if (href.includes('financial')) return 'money';
    if (href.includes('officer-requests')) return 'users';
    return 'file';
  };

  let countdown = '';
  if (nextEvent) {
    if (nextEvent.days_left === 0) countdown = 'Today';
    else if (nextEvent.days_left === 1) countdown = 'Tomorrow';
    else countdown = `In ${nextEvent.days_left} days`;
  }
%>

<main id="main" class="container dash">
  <%# ---------- Short header: greeting, date, one main action ---------- %>
  <div class="dash-head">
    <div>
      <h1><%= hello %>, <%= currentUser.first_name %></h1>
      <p class="meta"><%= roleLabels[currentUser.role] %> &middot; <%= todayText %></p>
    </div>
    <div class="action-row">
      <% if (isOfficer) { %>
        <a class="btn btn-secondary" href="/office/check-in">Office check-in</a>
      <% } %>
      <a class="btn btn-primary" href="/transactions/new">Make a request</a>
    </div>
  </div>

  <% if (currentUser.officer_request_status === 'pending') { %>
    <p class="alert alert-info">Your officer role request is waiting for the President.</p>
  <% } %>

  <%# ---------- One row of numbers ---------- %>
  <h2 class="visually-hidden">At a glance</h2>
  <div class="dash-numbers">
    <% if (isOfficer) { %>
      <a class="card stat-card<%= waiting > 0 ? ' stat-card-active' : '' %>" href="#attention">
        <span class="stat-number"><%= waiting %></span>
        <span class="stat-label">To do</span>
      </a>
    <% } %>
    <a class="card stat-card" href="/transactions">
      <span class="stat-number"><%= summary.active_requests %></span>
      <span class="stat-label">My requests in progress</span>
    </a>
    <a class="card stat-card" href="/events/my-registrations">
      <span class="stat-number"><%= summary.upcoming_events %></span>
      <span class="stat-label">My upcoming events</span>
    </a>
    <a class="card stat-card" href="/concerns/my">
      <span class="stat-number"><%= summary.open_concerns %></span>
      <span class="stat-label">My open concerns</span>
    </a>
  </div>

  <%# ---------- Officers: what needs their attention, as a simple list ---------- %>
  <% if (isOfficer) { %>
    <section class="card dash-panel" id="attention" aria-labelledby="attention-title">
      <h2 id="attention-title" class="dash-panel-title">Needs your attention</h2>
      <% if (waitingTasks.length === 0) { %>
        <p class="dash-all-done">
          <span class="icon-tile icon-tile-sm"><%- include('../partials/icon', { name: 'check' }) %></span>
          All caught up. Nothing is waiting for you.
        </p>
      <% } else { %>
        <ul class="task-list">
          <% waitingTasks.forEach((t) => { %>
            <li>
              <span class="task-icon"><%- include('../partials/icon', { name: taskIcon(t.href) }) %></span>
              <span class="task-label"><%= t.label %></span>
              <span class="task-count"><%= t.count %></span>
              <a class="btn btn-secondary btn-sm" href="<%= t.href %>">Open <span class="visually-hidden"><%= t.label %></span></a>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% } %>

  <%# ---------- Next event + latest news, side by side ---------- %>
  <div class="dash-pair">
    <section class="card dash-panel" aria-labelledby="next-title">
      <div class="dash-panel-head">
        <h2 id="next-title" class="dash-panel-title">Next event</h2>
        <a class="text-link" href="/events">All events</a>
      </div>
      <% if (!nextEvent) { %>
        <p class="muted">No events scheduled yet.</p>
      <% } else { %>
        <% const badge = dateBadge(nextEvent.event_date); %>
        <div class="dash-event">
          <span class="date-badge" aria-hidden="true">
            <span class="date-badge-month"><%= badge.month %></span>
            <span class="date-badge-day"><%= badge.day %></span>
          </span>
          <div>
            <p class="dash-event-title"><a href="/events/<%= nextEvent.id %>"><%= nextEvent.title %></a></p>
            <p class="meta"><%= countdown %> &middot; <%= formatTime(nextEvent.start_time) %> &middot; <%= nextEvent.venue || 'Venue to be announced' %></p>
            <p class="meta"><%= nextEvent.registered ? "You're registered." : 'You have not registered yet.' %></p>
          </div>
        </div>
      <% } %>
    </section>

    <section class="card dash-panel" aria-labelledby="news-title">
      <div class="dash-panel-head">
        <h2 id="news-title" class="dash-panel-title">Latest news</h2>
        <a class="text-link" href="/announcements">All news</a>
      </div>
      <% if (announcements.length === 0) { %>
        <p class="muted">Nothing new right now.</p>
      <% } else { %>
        <ul class="dash-news-list">
          <% announcements.forEach((a) => { %>
            <li>
              <a href="/announcements/<%= a.id %>"><%= a.title %></a>
              <span class="meta"><%= formatDate(a.news_date) %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>
</main>

<%- include('../partials/foot') %>
