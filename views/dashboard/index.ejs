<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
  // Officer tasks with something waiting come first; the zero ones go to the end
  const sortedTasks = tasks.slice().sort((a, b) => (b.count > 0) - (a.count > 0));
  const waiting = tasks.reduce((sum, t) => sum + Number(t.count), 0);
%>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow"><%= roleLabels[currentUser.role] %></p>
      <h1>Hi, <%= currentUser.first_name %>!</h1>
      <% if (currentUser.officer_request_status === 'pending') { %>
        <p class="page-lead">Your officer role request is waiting for the President.</p>
      <% } else if (tasks.length > 0) { %>
        <p class="page-lead"><%= waiting === 0 ? 'You\'re all caught up.' : waiting + (waiting === 1 ? ' thing needs' : ' things need') + ' your attention.' %></p>
      <% } else { %>
        <p class="page-lead">Here's what's happening with you.</p>
      <% } %>
      <a class="text-link" href="/profile">View my profile</a>
    </div>
    <a class="btn btn-primary" href="/transactions/new">Make a request <span class="arrow" aria-hidden="true">&rarr;</span></a>
  </div>

  <% if (tasks.length > 0) { %>
    <%# Officers: their to-do list is the most important thing on the page %>
    <section aria-labelledby="tasks-heading">
      <div class="section-heading">
        <h2 id="tasks-heading">Your to-do list</h2>
      </div>
      <div class="card-grid">
        <% sortedTasks.forEach((t) => { %>
          <a class="card stat-card<%= t.count > 0 ? ' stat-card-active' : '' %>" href="<%= t.href %>">
            <span class="stat-number"><%= t.count %></span>
            <span class="stat-label"><%= t.label %></span>
          </a>
        <% }) %>
      </div>
      <h3 class="section-gap">Go to</h3>
      <ul class="chip-list">
        <% officerLinks.forEach(([label, href]) => { %>
          <li><a href="<%= href %>"><%= label %></a></li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <section class="section-gap" aria-labelledby="mine-heading">
    <div class="section-heading">
      <h2 id="mine-heading">My stuff</h2>
    </div>
    <div class="card-grid-3">
      <a class="card stat-card" href="/transactions">
        <span class="stat-number"><%= summary.active_requests %></span>
        <span class="stat-label">Requests in progress</span>
      </a>
      <a class="card stat-card" href="/events/my-registrations">
        <span class="stat-number"><%= summary.upcoming_events %></span>
        <span class="stat-label">Events I'm going to</span>
      </a>
      <a class="card stat-card" href="/concerns/my">
        <span class="stat-number"><%= summary.open_concerns %></span>
        <span class="stat-label">Open concerns</span>
      </a>
    </div>
  </section>

  <div class="card-grid-2 section-gap">
    <section class="card" aria-labelledby="events-heading">
      <h2 id="events-heading">Coming up</h2>
      <% if (events.length === 0) { %>
        <p class="muted">No events scheduled yet.</p>
      <% } else { %>
        <ul class="plain-list">
          <% events.forEach((e) => { %>
            <li>
              <a href="/events/<%= e.id %>"><%= e.title %></a>
              <div class="meta"><%= formatDate(e.event_date) %> &middot; <%= e.venue %></div>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <p><a class="text-link" href="/events">All events <span class="arrow" aria-hidden="true">&rarr;</span></a></p>
    </section>
    <section class="card" aria-labelledby="news-heading">
      <h2 id="news-heading">Latest news</h2>
      <% if (announcements.length === 0) { %>
        <p class="muted">Nothing new right now.</p>
      <% } else { %>
        <ul class="plain-list">
          <% announcements.forEach((a) => { %>
            <li>
              <a href="/announcements/<%= a.id %>"><%= a.title %></a>
              <div class="meta"><%= formatDate(a.published_at) %></div>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <p><a class="text-link" href="/announcements">All news <span class="arrow" aria-hidden="true">&rarr;</span></a></p>
    </section>
  </div>

  <div class="page-end">
    <p>Something bothering you on campus?</p>
    <a class="btn btn-secondary" href="/concerns/new">Raise a concern <span class="arrow" aria-hidden="true">&rarr;</span></a>
  </div>
</main>

<%- include('../partials/foot') %>
