<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Events</p>
      <h1>My events</h1>
      <p class="page-lead">Everything you've signed up for.</p>
    </div>
    <a class="btn btn-primary" href="/events">Find more events <span class="arrow" aria-hidden="true">&rarr;</span></a>
  </div>

  <% if (registrations.length === 0) { %>
    <div class="card empty-state">
      <p>You haven't joined any events yet.</p>
      <a class="btn btn-secondary" href="/events">Browse events</a>
    </div>
  <% } else { %>
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Event</th>
            <th scope="col">When</th>
            <th scope="col">Where</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          <% registrations.forEach((r) => { %>
            <tr>
              <td><a href="/events/<%= r.id %>"><%= r.title %></a></td>
              <td><%= formatDate(r.event_date) %>, <%= formatTime(r.start_time) %></td>
              <td><%= r.venue || 'To be announced' %></td>
              <td>
                <% if (r.status === 'published') { %>
                  <span class="pill pill-published">Upcoming</span>
                <% } else { %>
                  <%- include('../partials/status-pill', { status: r.status }) %>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>

<%- include('../partials/foot') %>
