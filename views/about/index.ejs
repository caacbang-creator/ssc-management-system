<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
  // Goals are stored one per line; empty lines are skipped
  const goals = about ? about.goals.split('\n').map((g) => g.trim()).filter(Boolean) : [];
  const letters = 'abcdefghijklmnopqrstuvwxyz';
  const goalIcons = ['users', 'shield', 'chat', 'calendar'];

  // "Jester Carl SJ. Sumpay" -> "JS": first letter of the first and the last word
  const initials = (name) => {
    const words = name.split(' ').filter(Boolean);
    return (words[0][0] + (words.length > 1 ? words[words.length - 1][0] : '')).toUpperCase();
  };

  // The newest photo is the header background; the next five fill the photo strip
  const heroPhoto = photos.length > 0 ? photos[0] : null;
  const stripPhotos = photos.slice(1, 6);
%>

<main id="main">
  <%# ---------- Header: who we are, over an event photo ---------- %>
  <section class="photo-hero" aria-labelledby="about-title">
    <% if (heroPhoto) { %>
      <img class="photo-hero-img" src="<%= heroPhoto.file_path %>" alt="">
    <% } %>
    <div class="container photo-hero-inner about-hero-inner fade-up">
      <img class="logo-img about-seal" src="/img/SSC.png" alt="" width="120" height="120">
      <div>
        <p class="eyebrow">About us</p>
        <h1 id="about-title">Supreme Student <span class="hero-accent">Council</span></h1>
        <% if (about) { %>
          <p class="photo-hero-lead"><%= about.overview %></p>
        <% } %>
        <div class="action-row">
          <a class="btn btn-light" href="/officers">Meet the officers <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <% if (currentUser && currentUser.role === 'president') { %>
            <a class="btn btn-outline-light" href="/manage/about">Edit this page</a>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    <% if (!about) { %>
      <div class="card empty-state section-gap">
        <p>We're still writing this page. Come back soon.</p>
      </div>
    <% } else { %>
      <%# ---------- Mission and vision, overlapping the header ---------- %>
      <div class="mv-grid fade-up fade-up-delay-1">
        <section class="card mv-card" aria-labelledby="mission-title">
          <span class="icon-tile"><%- include('../partials/icon', { name: 'target' }) %></span>
          <h2 id="mission-title">Our mission</h2>
          <p class="mv-text keep-lines"><%= about.mission %></p>
        </section>
        <section class="card mv-card" aria-labelledby="vision-title">
          <span class="icon-tile"><%- include('../partials/icon', { name: 'eye' }) %></span>
          <h2 id="vision-title">Our vision</h2>
          <p class="mv-text keep-lines"><%= about.vision %></p>
        </section>
      </div>

      <%# ---------- Goals and objectives (a, b, c...) ---------- %>
      <% if (goals.length > 0) { %>
        <section class="section-gap" aria-labelledby="goals-title">
          <div class="section-heading">
            <h2 id="goals-title">Goals and objectives</h2>
          </div>
          <ol class="goal-grid">
            <% goals.forEach((goal, i) => { %>
              <li class="card goal-card">
                <span class="goal-top">
                  <span class="goal-letter" aria-hidden="true"><%= letters[i % 26] %></span>
                  <span class="icon-tile icon-tile-sm"><%- include('../partials/icon', { name: goalIcons[i % goalIcons.length] }) %></span>
                </span>
                <p><%= goal %></p>
              </li>
            <% }) %>
          </ol>
        </section>
      <% } %>
    <% } %>

    <%# ---------- Officers preview ---------- %>
    <section class="section-gap" aria-labelledby="team-title">
      <div class="section-heading">
        <h2 id="team-title">Meet the officers</h2>
        <a class="text-link" href="/officers">Full directory <span class="arrow" aria-hidden="true">&rarr;</span></a>
      </div>
      <% if (officers.length === 0) { %>
        <div class="card empty-state"><p>The officer list is coming soon.</p></div>
      <% } else { %>
        <ul class="team-grid">
          <% officers.forEach((o) => { %>
            <li class="card team-card">
              <% if (o.photo_path) { %>
                <img class="team-avatar" src="<%= o.photo_path %>" alt="" loading="lazy" width="72" height="72">
              <% } else { %>
                <span class="team-avatar" aria-hidden="true"><%= initials(o.full_name) %></span>
              <% } %>
              <span class="team-name"><%= o.full_name %></span>
              <span class="team-position"><%= o.position %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <%# ---------- Photos from recent events ---------- %>
    <% if (stripPhotos.length > 0) { %>
      <section class="section-gap" aria-labelledby="life-title">
        <div class="section-heading">
          <h2 id="life-title">Life at the SSC</h2>
          <a class="text-link" href="/events">All events <span class="arrow" aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="photo-strip">
          <% stripPhotos.forEach((p) => { %>
            <a class="photo-strip-item" href="/events/<%= p.event_id %>#photos">
              <img src="<%= p.file_path %>" alt="<%= p.caption || `Photo from ${p.title}` %>" loading="lazy">
              <span class="photo-strip-label"><%= p.title %></span>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <div class="page-end">
      <p>Have an idea or a concern for the SSC?</p>
      <a class="btn btn-primary" href="/concerns/new">Tell us <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</main>

<%- include('../partials/foot') %>
