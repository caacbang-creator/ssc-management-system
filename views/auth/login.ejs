<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main id="main" class="container form-page">
  <section class="card">
    <p class="eyebrow">Welcome back</p>
    <h1>Log in</h1>
    <p class="muted">Use your CSPC student e-mail.</p>

    <% if (errors.length > 0) { %>
      <div class="alert alert-error" role="alert">
        <ul>
          <% errors.forEach((error) => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <form method="post" action="/login" novalidate>
      <div class="form-field">
        <label for="email">E-mail</label>
        <input type="email" id="email" name="email" value="<%= old.email || '' %>"
          autocomplete="username" placeholder="you@my.cspc.edu.ph" required>
      </div>
      <div class="form-field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Log in <span class="arrow" aria-hidden="true">&rarr;</span></button>
      </div>
    </form>
  </section>
  <p class="form-footer">New here? <a href="/register">Create your account</a></p>
</main>

<%- include('../partials/foot') %>
