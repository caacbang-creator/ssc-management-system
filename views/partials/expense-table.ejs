<%
  // Receipts of a liquidation report, grouped by item like the paper report.
  // Usage: include('partials/expense-table', { expenses, editBase })
  //   editBase: '/manage/financial-reports/5' to show Edit / Remove buttons, or '' for the public page.
  // The total is added up here from the lines that are shown, never typed in.
  const SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const shortDate = (value) => {
    const [y, m, d] = String(value).slice(0, 10).split('-');
    return `${SHORT[Number(m) - 1]} ${Number(d)}, ${y}`;
  };
  // How many lines each item has, so its name can span those rows
  const groupSize = {};
  expenses.forEach((x) => { groupSize[x.item] = (groupSize[x.item] || 0) + 1; });
  const total = expenses.reduce((sum, x) => sum + Number(x.amount), 0);
%>
<div class="table-wrap">
  <table class="ledger">
    <thead>
      <tr>
        <th scope="col">Item</th>
        <th scope="col">Receipt no.</th>
        <th scope="col">Date</th>
        <th scope="col">Particulars</th>
        <th scope="col" class="num">Amount</th>
        <% if (editBase) { %><th scope="col"><span class="visually-hidden">Actions</span></th><% } %>
      </tr>
    </thead>
    <tbody>
      <% expenses.forEach((x, i) => { %>
        <tr>
          <% if (i === 0 || expenses[i - 1].item !== x.item) { %>
            <th scope="rowgroup" rowspan="<%= groupSize[x.item] %>" class="ledger-item"><%= x.item %></th>
          <% } %>
          <td><%= x.receipt_no || 'None' %><% if (!x.receipt_no) { %><span class="visually-hidden"> (acknowledgement receipt)</span><% } %></td>
          <td class="nowrap"><%= shortDate(x.receipt_date) %></td>
          <td><%= x.particulars %></td>
          <td class="num"><%= formatMoney(x.amount) %></td>
          <% if (editBase) { %>
            <td class="ledger-actions">
              <a class="btn btn-secondary btn-sm" href="<%= editBase %>/expenses/<%= x.id %>/edit">Edit <span class="visually-hidden">receipt <%= x.receipt_no || '' %> of <%= x.item %></span></a>
              <form method="post" action="<%= editBase %>/expenses/<%= x.id %>/delete" class="inline-form">
                <button type="submit" class="btn btn-danger btn-sm">Remove <span class="visually-hidden">receipt <%= x.receipt_no || '' %> of <%= x.item %></span></button>
              </form>
            </td>
          <% } %>
        </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr>
        <th scope="row" colspan="4">Total expenses</th>
        <td class="num"><strong><%= formatMoney(total) %></strong></td>
        <% if (editBase) { %><td></td><% } %>
      </tr>
    </tfoot>
  </table>
</div>
