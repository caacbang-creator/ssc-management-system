<%
  // One completed event as a clickable photo card. Usage: include('partials/past-event-card', { e })
  // Events without photos get a navy tile with the date, so the grid still lines up.
  const badge = dateBadge(e.event_date);
%>
<a class="card link-card past-event-card" href="/events/<%= e.id %>">
  <span class="event-cover">
    <% if (e.cover_path) { %>
      <%# The title is right below, so the photo is decorative here %>
      <img src="<%= e.cover_path %>" alt="" loading="lazy">
      <span class="slide-badge"><%= e.photo_count %> <%= e.photo_count === 1 ? 'photo' : 'photos' %></span>
    <% } else { %>
      <span class="event-cover-date" aria-hidden="true">
        <span class="date-badge-month"><%= badge.month %></span>
        <span class="date-badge-day"><%= badge.day %></span>
      </span>
    <% } %>
  </span>
  <h3><%= e.title %></h3>
  <span class="meta"><%= formatDate(e.event_date) %> <% if (e.venue) { %> &middot; <%= e.venue %><% } %></span>
  <span class="card-link">See how it went <span class="arrow" aria-hidden="true">&rarr;</span></span>
</a>
