<%
  // A person's directory photo, or their initials when there is none.
  // Usage: include('partials/avatar', { person, size: 'sm' | 'lg' | '', duty: true/false })
  //   person needs first_name, last_name and photo_path (photo_path may be null).
  // duty = true adds the gold OOTD ring. The full name is the alt text.
  const fullName = `${person.first_name} ${person.last_name}`;
  const initials = (person.first_name[0] + (person.last_name ? person.last_name[0] : '')).toUpperCase();
  const classes = ['avatar', locals.size ? 'avatar-' + size : '', locals.duty ? 'avatar-duty' : ''].filter(Boolean).join(' ');
%>
<% if (person.photo_path) { %>
  <img class="<%= classes %>" src="<%= person.photo_path %>" alt="<%= fullName %>" loading="lazy">
<% } else { %>
  <span class="<%= classes %>" role="img" aria-label="<%= fullName %>"><%= initials %></span>
<% } %>
