<%
  // locals.x is used so the nav still renders on the 500 page even if a value was never set
  const user = locals.currentUser || null;
  const path = locals.currentPath || '';

  // Kept short on purpose: seven links are easy to scan. Officers is reached from About and the footer.
  const links = [
    { href: '/', label: 'Home' },
    { href: '/about', label: 'About' },
    { href: '/announcements', label: 'News' },
    { href: '/events', label: 'Events' },
    { href: '/concerns', label: 'Concerns' },
    { href: '/transactions', label: 'Services', also: ['/items'] },  // the borrowing catalog is a service too
    { href: '/documents', label: 'Documents' }
  ];
  // A section stays underlined on its inner pages too (e.g. /events/3 keeps "Events" active)
  const isActive = (href) => href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
  const linkActive = (link) => isActive(link.href) || (link.also || []).some(isActive);
%>
<header class="site-header">
  <div class="container header-inner">
    <%# Officer pages: show or hide the left sidebar. A small POST form that saves the choice in the
        session and comes back to this page (no JavaScript). %>
    <% if (locals.showSidebar) { %>
      <form method="post" action="/preferences/sidebar" class="sidebar-toggle">
        <input type="hidden" name="show" value="<%= locals.sidebarOpen ? '0' : '1' %>">
        <input type="hidden" name="returnTo" value="<%= locals.currentUrl || path %>">
        <button type="submit" aria-pressed="<%= locals.sidebarOpen ? 'true' : 'false' %>">
          <span aria-hidden="true"><%= locals.sidebarOpen ? '✕' : '☰' %></span>
          <span class="sidebar-toggle-text"><%= locals.sidebarOpen ? 'Hide menu' : 'Menu' %></span>
        </button>
      </form>
    <% } %>
    <a class="brand" href="/">
      <img class="logo-img" src="/img/SSC.png" alt="SSC logo" width="34" height="44">
      <span class="wordmark">
        <span class="wordmark-title">Supreme Student Council</span>
        <span class="wordmark-sub">Camarines Sur Polytechnic Colleges</span>
      </span>
    </a>

    <%# Desktop: the full nav. Hidden on small screens by CSS.
        The last item (Register, or Dashboard when logged in) sits in the top-right corner of the Z. %>
    <nav class="site-nav nav-desktop" aria-label="Main">
      <ul>
        <% links.forEach((link) => { %>
          <li><a href="<%= link.href %>"<% if (linkActive(link)) { %> aria-current="page"<% } %>><%= link.label %></a></li>
        <% }) %>
        <%# Office check-in is in the officer sidebar and on the dashboard, so the top menu stays one line %>
        <% if (user) { %>
          <li class="nav-user">
            <form method="post" action="/logout" class="inline-form">
              <button type="submit" class="link-button">Log out</button>
            </form>
            <a class="nav-cta" href="/dashboard"<% if (path === '/dashboard') { %> aria-current="page"<% } %>><span class="visually-hidden">Hi, <%= user.first_name %>. </span>My dashboard</a>
          </li>
        <% } else { %>
          <li><a href="/login"<% if (path === '/login') { %> aria-current="page"<% } %>>Log in</a></li>
          <li><a class="nav-cta" href="/register"<% if (path === '/register') { %> aria-current="page"<% } %>>Join now</a></li>
        <% } %>
      </ul>
    </nav>

    <%# Small screens: the same links inside <details>, which opens and closes without JavaScript. %>
    <details class="nav-mobile">
      <summary>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
        Menu
      </summary>
      <nav class="site-nav" aria-label="Main">
        <ul>
          <% if (user) { %>
            <li><a href="/dashboard"<% if (path === '/dashboard') { %> aria-current="page"<% } %>>My dashboard</a></li>
          <% } %>
          <% links.forEach((link) => { %>
            <li><a href="<%= link.href %>"<% if (linkActive(link)) { %> aria-current="page"<% } %>><%= link.label %></a></li>
          <% }) %>
          <% if (user && user.role !== 'student') { %>
            <li><a href="/office/check-in"<% if (isActive('/office')) { %> aria-current="page"<% } %>>Office check-in</a></li>
          <% } %>
          <% if (user) { %>
            <li class="nav-user">
              <a href="/profile"<% if (path === '/profile') { %> aria-current="page"<% } %>>My profile</a>
              <form method="post" action="/logout" class="inline-form">
                <button type="submit" class="link-button">Log out</button>
              </form>
            </li>
          <% } else { %>
            <li><a href="/login"<% if (path === '/login') { %> aria-current="page"<% } %>>Log in</a></li>
            <li><a class="nav-cta" href="/register"<% if (path === '/register') { %> aria-current="page"<% } %>>Join now</a></li>
          <% } %>
        </ul>
      </nav>
    </details>
  </div>
</header>
<%# Officer pages: sidebar on the left, the page on the right. foot.ejs closes these two divs. %>
<% if (locals.showSidebar) { %>
<div class="app-shell<%= locals.sidebarOpen ? ' app-shell-open' : '' %>">
  <aside class="app-sidebar">
    <%- include('sidebar', { user, path }) %>
  </aside>
  <div class="app-content">
<% } %>
<% if (locals.flash) { %>
  <div class="container">
    <p class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></p>
  </div>
<% } %>
