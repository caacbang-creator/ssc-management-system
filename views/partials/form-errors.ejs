<% if (errors.length > 0) { %>
  <div class="alert alert-error" role="alert">
    <p><strong><%= errors.length === 1 ? 'One thing needs fixing:' : errors.length + ' things need fixing:' %></strong></p>
    <ul>
      <% errors.forEach((error) => { %>
        <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
<% } %>
