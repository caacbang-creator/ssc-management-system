<%#
  Upload form + list of videos with a Remove button. Shared by event and announcement pages.
  Needs: videos, basePath (e.g. /manage/events/5/videos), videoErrors, videoTitle.
%>
<section class="card section-gap" id="videos" aria-labelledby="videos-title">
  <h2 id="videos-title">Videos (<%= videos.length %>)</h2>
  <% if (videoErrors.length > 0) { %><%- include('form-errors', { errors: videoErrors }) %><% } %>

  <%# enctype="multipart/form-data" is required to send a file %>
  <form method="post" action="<%= basePath %>" enctype="multipart/form-data" class="video-form" novalidate>
    <div class="form-field">
      <label for="video">Video file</label>
      <input type="file" id="video" name="video" accept="video/mp4,video/webm,video/quicktime" aria-describedby="video-hint">
      <p class="hint" id="video-hint">MP4, WebM or MOV, up to 250 MB. A big video can take a few minutes to upload; keep this page open.</p>
    </div>
    <div class="form-field">
      <label for="video-title">Title</label>
      <input type="text" id="video-title" name="title" value="<%= videoTitle %>" maxlength="150"
        placeholder="Highlights of the Oath of Office" aria-describedby="title-hint" required>
      <p class="hint" id="title-hint">Required. Shown under the video and read out by screen readers.</p>
    </div>
    <button type="submit" class="btn btn-primary">Upload video <span class="arrow" aria-hidden="true">&rarr;</span></button>
  </form>

  <% if (videos.length === 0) { %>
    <p class="muted section-gap-sm">No videos yet.</p>
  <% } else { %>
    <ul class="video-admin-list">
      <% videos.forEach((v) => { %>
        <li class="video-admin-item">
          <%# preload="metadata": only the length and first frame load until someone presses play %>
          <video src="<%= v.file_path %>" controls preload="metadata" aria-label="<%= v.title %>"></video>
          <div>
            <p class="video-title"><%= v.title %></p>
            <p class="meta">Added <%= formatDate(v.created_at) %></p>
            <form method="post" action="<%= basePath %>/<%= v.id %>/delete">
              <button type="submit" class="btn btn-danger btn-sm">Remove <span class="visually-hidden"><%= v.title %></span></button>
            </form>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</section>
