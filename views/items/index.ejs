<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Services</p>
      <h1>Things you can borrow</h1>
      <p class="page-lead">Send a request, then pick it up at the SSC office once it's approved.</p>
    </div>
    <a class="btn btn-primary" href="/transactions/new?type=item_borrowing">Borrow an item <span class="arrow" aria-hidden="true">&rarr;</span></a>
  </div>

  <% if (items.length === 0) { %>
    <div class="card empty-state">
      <p>Nothing to borrow right now. Check back later.</p>
    </div>
  <% } else { %>
    <div class="card table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Item</th>
            <th scope="col">Details</th>
            <th scope="col" class="num">We have</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach((i) => { %>
            <tr>
              <td><strong><%= i.name %></strong></td>
              <td class="muted"><%= i.description || '' %></td>
              <td class="num"><%= i.quantity %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

  <div class="page-end">
    <p>Already borrowed something? Check its status.</p>
    <div class="action-row">
      <% if (['pro', 'president'].includes(currentUser.role)) { %>
        <a class="btn btn-secondary" href="/manage/items">Manage items</a>
      <% } %>
      <a class="btn btn-secondary" href="/transactions">My requests <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</main>

<%- include('../partials/foot') %>
