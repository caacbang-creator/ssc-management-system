<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main id="main" class="container">
  <div class="page-heading">
    <div>
      <p class="eyebrow">Services</p>
      <h1>Things you can borrow</h1>
      <p class="page-lead">Send a request, then pick it up from the Property Custodian at the SSC office once it's approved.</p>
    </div>
    <a class="btn btn-primary" href="/transactions/new?type=item_borrowing">Borrow an item <span class="arrow" aria-hidden="true">&rarr;</span></a>
  </div>

  <% if (items.length === 0) { %>
    <div class="card empty-state">
      <p>Nothing to borrow right now. Check back later.</p>
    </div>
  <% } else { %>
    <%# Availability only; who borrowed what stays in the custodian's log %>
    <div class="item-grid">
      <% items.forEach((i) => { %>
        <% const inOffice = Math.max(0, i.quantity - Number(i.units_out)); %>
        <article class="card item-card<%= i.status === 'available' ? '' : ' item-card-off' %>">
          <div class="item-card-head">
            <span class="icon-tile icon-tile-sm"><%- include('../partials/icon', { name: 'box' }) %></span>
            <div>
              <h2 class="item-name"><%= i.name %></h2>
              <% if (i.description) { %><p class="meta"><%= i.description %></p><% } %>
            </div>
          </div>
          <p class="item-status">
            <% if (i.status !== 'available') { %>
              <span class="pill pill-rejected">Not available</span>
              <span class="meta"><%= i.status_note %></span>
            <% } else if (inOffice === 0) { %>
              <span class="pill pill-pending">All out on loan</span>
              <span class="meta">You can still request it for a later date.</span>
            <% } else { %>
              <span class="pill pill-approved">Available</span>
              <span class="meta"><%= inOffice %> of <%= i.quantity %> in the office</span>
            <% } %>
          </p>
          <% if (i.status === 'available') { %>
            <a class="btn btn-secondary btn-sm" href="/transactions/new?type=item_borrowing&item=<%= i.id %>">Request <span class="visually-hidden"><%= i.name %></span></a>
          <% } %>
        </article>
      <% }) %>
    </div>
  <% } %>

  <div class="page-end">
    <p>Already borrowed something? Check its status.</p>
    <div class="action-row">
      <% if (['property_custodian', 'president'].includes(currentUser.role)) { %>
        <a class="btn btn-secondary" href="/manage/items">Manage items</a>
      <% } %>
      <a class="btn btn-secondary" href="/transactions">My requests <span class="arrow" aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</main>

<%- include('../partials/foot') %>
